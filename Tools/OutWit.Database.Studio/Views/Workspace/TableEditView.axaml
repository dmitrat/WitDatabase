<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:OutWit.Database.Studio.ViewModels.Tabs"
             xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
             xmlns:c="using:OutWit.Database.Studio.Controls"
             xmlns:models="using:OutWit.Database.Studio.Models"
             xmlns:conv="using:OutWit.Database.Studio.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OutWit.Database.Studio.Views.Workspace.TableEditView"
             x:DataType="tabs:TableEditTabViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

        <!-- Read-only banner: an explanation, not a row of mysteriously grey buttons (WS-35) -->
        <Border Grid.Row="0"
                Background="{DynamicResource Wit.Warn.Surface}"
                BorderBrush="{DynamicResource Wit.Warn.Border}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding IsReadOnly}"
                AutomationProperties.AutomationId="TableEditReadOnlyBanner">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                          Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"
                          Foreground="{DynamicResource Wit.Warn.Text}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ReadOnlyReason}"
                           FontSize="{DynamicResource Wit.Font.Body}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Wit.Warn.Text}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Table Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static ui:StudioIcons.DB_TABLE}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"
                                  Foreground="{DynamicResource Wit.Accent.Text}"/>
                        <TextBlock Text="{Binding TableName}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource Wit.Font.SectionTitle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Row count -->
                    <TextBlock VerticalAlignment="Center"
                               Foreground="Gray">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static conv:LocalizedText.Plural}"
                                          ConverterParameter="Count.RowsBracketed">
                                <DynamicResource ResourceKey="S.$language"/>
                                <Binding Path="TotalRowCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <!-- Changes indicator -->
                    <Border Background="{DynamicResource Wit.Warn.Surface}"
                            BorderBrush="{DynamicResource Wit.Warn.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            IsVisible="{Binding HasChanges}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                                      Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"
                                      Foreground="{DynamicResource Wit.Warn.Text}"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Unsaved.Title}"
                                       FontSize="{DynamicResource Wit.Font.Body}"
                                       Foreground="{DynamicResource Wit.Warn.Text}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <!-- Pages (WS-31). The table used to be read with a bare LIMIT and no way to see
                         the second page at all; these are plain buttons until the grid is redesigned. -->
                    <Button AutomationProperties.AutomationId="TableEditPreviousPage" AutomationProperties.Name="{DynamicResource S.Grid.PrevPage}" Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoToPreviousPage}"
                            ToolTip.Tip="{DynamicResource S.Grid.PrevPage}"
                            Height="{DynamicResource Wit.Height.Button}" MinWidth="32"
                            Padding="8,0"
                            Content="&lt;"/>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="Gray"
                               FontSize="{DynamicResource Wit.Font.Body}"
                               ToolTip.Tip="{Binding PagingNote}">
                        <Run Text="{DynamicResource S.Grid.PageLabel}"/>
                        <Run Text="{Binding PageIndex}"/>
                    </TextBlock>

                    <Button AutomationProperties.AutomationId="TableEditNextPage" AutomationProperties.Name="{DynamicResource S.Grid.NextPage}" Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoToNextPage}"
                            ToolTip.Tip="{DynamicResource S.Grid.NextPage}"
                            Height="{DynamicResource Wit.Height.Button}" MinWidth="32"
                            Padding="8,0"
                            Content="&gt;"/>

                    <Rectangle Width="1"
                               Fill="{DynamicResource Wit.Line}"
                               Margin="4,4"/>

                    <Button AutomationProperties.AutomationId="TableEditRefreshData" AutomationProperties.Name="{DynamicResource S.Grid.Refresh}" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding CanRefresh}"
                            ToolTip.Tip="{DynamicResource S.Grid.Refresh}"
                            Width="32" Height="{DynamicResource Wit.Height.Button}"
                            Padding="0">
                        <PathIcon Data="{x:Static ui:StudioIcons.TABLE_STRUCTURE_REFRESH}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
                    </Button>

                    <Rectangle Width="1"
                               Fill="{DynamicResource Wit.Line}"
                               Margin="4,4"/>

                    <Button AutomationProperties.AutomationId="TableEditAddNewRow" AutomationProperties.Name="{DynamicResource S.Grid.AddRow}" Command="{Binding AddRowCommand}"
                            IsEnabled="{Binding CanAddRow}"
                            ToolTip.Tip="{DynamicResource S.Grid.AddRow}"
                            Width="32" Height="{DynamicResource Wit.Height.Button}"
                            Padding="0">
                        <PathIcon Data="{x:Static ui:StudioIcons.TABLE_EDITOR_ADD_ROW}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
                    </Button>

                    <Button AutomationProperties.AutomationId="TableEditDeleteSelectedRow" AutomationProperties.Name="{DynamicResource S.Grid.DeleteRow}" Command="{Binding DeleteRowCommand}"
                            IsEnabled="{Binding CanDeleteRow}"
                            ToolTip.Tip="{DynamicResource S.Grid.DeleteRow}"
                            Width="32" Height="{DynamicResource Wit.Height.Button}"
                            Padding="0">
                        <PathIcon Data="{x:Static ui:StudioIcons.TABLE_EDITOR_DELETE_ROW}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
                    </Button>

                    <Rectangle Width="1"
                               Fill="{DynamicResource Wit.Line}"
                               Margin="4,4"/>

                    <Button AutomationProperties.AutomationId="TableEditCommitChanges" AutomationProperties.Name="{DynamicResource S.Grid.Commit}" Command="{Binding CommitCommand}"
                            IsEnabled="{Binding CanCommit}"
                            ToolTip.Tip="{DynamicResource S.Grid.Commit}"
                            Width="32" Height="{DynamicResource Wit.Height.Button}"
                            Padding="0"
                            Classes="accent">
                        <PathIcon Data="{x:Static ui:StudioIcons.TABLE_EDITOR_COMMIT}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
                    </Button>

                    <Button AutomationProperties.AutomationId="TableEditDiscardChanges" AutomationProperties.Name="{DynamicResource S.Grid.Discard}" Command="{Binding RollbackCommand}"
                            IsEnabled="{Binding CanRollback}"
                            ToolTip.Tip="{DynamicResource S.Grid.Discard}"
                            Width="32" Height="{DynamicResource Wit.Height.Button}"
                            Padding="0">
                        <PathIcon Data="{x:Static ui:StudioIcons.TABLE_EDITOR_ROLLBACK}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
                    </Button>

                    <!-- WS-32, the other direction: what the buffer will send, BEFORE it is sent -
                         which is the only moment at which it is worth reading. -->
                    <Button AutomationProperties.AutomationId="TableEditShowChangesSql"
                            AutomationProperties.Name="{DynamicResource S.Grid.ShowChangesSql}"
                            Command="{Binding ShowChangesSqlCommand}"
                            IsEnabled="{Binding HasChanges}"
                            ToolTip.Tip="{DynamicResource S.Grid.ShowChangesSql.Tip}"
                            Height="{DynamicResource Wit.Height.Button}" Padding="10,0"
                            Content="SQL"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The filter row (4.3). One box per column, joined with AND; anything that needs OR is what
             Show SQL is for. Not aligned with the grid's columns: the DataGrid here is Avalonia's and
             does not publish its column widths, and a row that ALMOST lines up is worse than one that
             plainly does not. -->
        <Border Grid.Row="2"
                Background="{DynamicResource Wit.Surface.Bar}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ColumnFilter">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Column}"
                                               FontSize="{DynamicResource Wit.Font.Control}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                                    <TextBox Text="{Binding Text, Mode=TwoWay}"
                                             Width="110" Height="{DynamicResource Wit.Height.Field}"
                                             Padding="4,0"
                                             VerticalContentAlignment="Center"
                                             PlaceholderText="{DynamicResource S.Grid.Filter}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="TableEditApplyFilters"
                        AutomationProperties.Name="{DynamicResource S.Grid.ApplyFilters}"
                        Content="{DynamicResource S.Grid.FilterButton}" Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="10,0"
                        Command="{Binding ApplyFiltersCommand}"/>
                <Button Grid.Column="2" Margin="4,0,0,0"
                        AutomationProperties.AutomationId="TableEditClearFilters"
                        AutomationProperties.Name="{DynamicResource S.Grid.ClearFilters}"
                        Content="{DynamicResource S.Toolbar.Clear}" Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="10,0"
                        Command="{Binding ClearFiltersCommand}"/>
            </Grid>
        </Border>

        <!-- The conflict (WS-37): both values, and a choice - never "the transaction was rejected". -->
        <Border Grid.Row="3"
                Background="{DynamicResource Wit.Warn.Surface}"
                BorderBrush="{DynamicResource Wit.Warn.Border}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding HasConflict}"
                AutomationProperties.AutomationId="TableEditConflictBanner">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ConflictSummary}"
                           FontSize="{DynamicResource Wit.Font.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Wit.Warn.Text}"/>

                <ItemsControl ItemsSource="{Binding ConflictColumns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ConflictedValue">
                            <Grid ColumnDefinitions="140,*,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Column}" FontSize="{DynamicResource Wit.Font.Control}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" FontSize="{DynamicResource Wit.Font.Mono.Data}" FontFamily="Consolas,monospace">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                            <DynamicResource ResourceKey="S.Grid.Conflict.Mine"/>
                                            <Binding Path="Mine"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="2" FontSize="{DynamicResource Wit.Font.Mono.Data}" FontFamily="Consolas,monospace">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                            <DynamicResource ResourceKey="S.Grid.Conflict.Theirs"/>
                                            <Binding Path="Theirs"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button AutomationProperties.AutomationId="TableEditReread"
                            AutomationProperties.Name="{DynamicResource S.Grid.Reread.Name}"
                            Content="{DynamicResource S.Grid.Reread}" Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="10,0"
                            Command="{Binding RereadCommand}"/>
                    <Button AutomationProperties.AutomationId="TableEditOverwrite"
                            AutomationProperties.Name="{DynamicResource S.Grid.Overwrite.Name}"
                            Content="{DynamicResource S.Grid.Overwrite}" Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="10,0"
                            Command="{Binding OverwriteCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <Grid Grid.Row="4">
            <!-- Editable DataGrid -->
            <c:EditableDataGrid ResultView="{Binding CurrentView}"
                                ColumnSettings="{Binding EditColumnSettings}"
                                SelectedRowView="{Binding SelectedRowView, Mode=TwoWay}"
                                ColumnInfos="{Binding Columns}"
                                CellEditedCommand="{Binding CellEditedCommand}"
                                SortCommand="{Binding SortByCommand}"
                                BorderThickness="0"
                                Background="Transparent"/>

            <!-- Nothing matched (4.7). Different from an empty table, and it offers something
                 different: the way back is clearing the filter, not looking for the rows. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        IsVisible="{Binding IsEmptyByFilter}">
                <TextBlock Text="{DynamicResource S.Grid.NoMatches}"
                           FontSize="{DynamicResource Wit.Font.SectionTitle}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                <TextBlock Text="{Binding ViewDescription}"
                           FontSize="{DynamicResource Wit.Font.Body}" HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="420" TextWrapping="Wrap"
                           Foreground="{DynamicResource Wit.Ink.Muted}"/>
                <Button AutomationProperties.AutomationId="TableEditClearFiltersEmpty"
                        AutomationProperties.Name="{DynamicResource S.Grid.ClearFilters}"
                        Content="{DynamicResource S.Grid.ClearFilter}" HorizontalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"/>
            </StackPanel>

            <!-- Loading Overlay -->
            <Border Background="{DynamicResource Wit.Scrim}"
                    IsVisible="{Binding IsLoading}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Width="32" Height="32"
                            Background="White"
                            CornerRadius="16">
                        <PathIcon Data="{x:Static ui:StudioIcons.DB_TABLE}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"
                                  Foreground="{DynamicResource Wit.Accent.Text}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource S.Grid.Loading}"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The footer (4.1): what the view is doing, how the page is being reached, the total on
             request, and the bridge to the editor (WS-32). -->
        <Border Grid.Row="5"
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- Runs do not put spaces between themselves, which the first version of this footer
                     read as "page0 ·12rows shown". One bound string per fact instead. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TableEditPageSummary">
                    <TextBlock FontSize="{DynamicResource Wit.Font.Control}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                <DynamicResource ResourceKey="S.Grid.Page"/>
                                <Binding Path="PageIndex"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="·" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.5" VerticalAlignment="Center"/>
                    <TextBlock FontSize="{DynamicResource Wit.Font.Control}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static conv:LocalizedText.Plural}"
                                          ConverterParameter="Count.RowsShown">
                                <DynamicResource ResourceKey="S.$language"/>
                                <Binding Path="TotalRowCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource S.Grid.Of}" FontSize="{DynamicResource Wit.Font.Control}" VerticalAlignment="Center" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalRows, TargetNullValue='—'}" FontSize="{DynamicResource Wit.Font.Control}"
                               VerticalAlignment="Center"/>
                    <Button AutomationProperties.AutomationId="TableEditCountRows"
                            AutomationProperties.Name="{DynamicResource S.Grid.Count.Name}"
                            Content="{DynamicResource S.Grid.Count}" Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="6,0"
                            IsVisible="{Binding TotalRows, Converter={x:Static ObjectConverters.IsNull}}"
                            Command="{Binding CountRowsCommand}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ViewDescription}"
                           Text="{Binding ViewDescription}"/>

                <ComboBox Grid.Column="3"
                          AutomationProperties.AutomationId="TableEditPageSize"
                          AutomationProperties.Name="{DynamicResource S.Grid.PageSize}"
                          ItemsSource="{Binding PageSizes}"
                          SelectedItem="{Binding PageSize, Mode=TwoWay}"
                          Height="{DynamicResource Wit.Height.Field}" MinWidth="80"
                          ToolTip.Tip="{DynamicResource S.Grid.PageSize.Tip}"/>

                <Button Grid.Column="4" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="TableEditShowSql"
                        AutomationProperties.Name="{DynamicResource S.Grid.ShowViewSql}"
                        Content="{DynamicResource S.Common.ShowSql}" Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="10,0"
                        ToolTip.Tip="{DynamicResource S.Grid.ShowViewSql.Tip}"
                        Command="{Binding ShowViewSqlCommand}"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Panel Grid.Row="6">
            
            <!-- Success Status -->
            <Border Background="{DynamicResource Wit.Ok.Surface}"
                    Padding="8,4"
                    IsVisible="{Binding LastOperationSuccess}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                  Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"
                                  Foreground="{DynamicResource Wit.Ok.Text}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource Wit.Ok.Text}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16">
                        <TextBlock Text="{DynamicResource S.Grid.Hint.Commit}"
                                   Foreground="{DynamicResource Wit.Ok.Text}"
                                   FontSize="{DynamicResource Wit.Font.Control}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.Grid.Hint.Delete}"
                                   Foreground="{DynamicResource Wit.Ok.Text}"
                                   FontSize="{DynamicResource Wit.Font.Control}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Error Status -->
            <Border Background="{DynamicResource Wit.Error.Surface}"
                    Padding="8,4"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                                  Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"
                                  Foreground="{DynamicResource Wit.Error.Text}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource Wit.Error.Text}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16">
                        <TextBlock Text="{DynamicResource S.Grid.Hint.Commit}"
                                   Foreground="{DynamicResource Wit.Error.Text}"
                                   FontSize="{DynamicResource Wit.Font.Control}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.Grid.Hint.Delete}"
                                   Foreground="{DynamicResource Wit.Error.Text}"
                                   FontSize="{DynamicResource Wit.Font.Control}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Default Status (no operation yet) -->
            <Border Background="{DynamicResource Wit.Surface.Panel}"
                    Padding="8,4"
                    IsVisible="{Binding IsDefaultState}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource S.Grid.Hint.Edit}"
                               Foreground="Gray"
                               FontSize="{DynamicResource Wit.Font.Body}"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16">
                        <TextBlock Text="{DynamicResource S.Grid.Hint.Commit}"
                                   Foreground="Gray"
                                   FontSize="{DynamicResource Wit.Font.Control}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.Grid.Hint.Delete}"
                                   Foreground="Gray"
                                   FontSize="{DynamicResource Wit.Font.Control}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Panel>
    </Grid>

</UserControl>
