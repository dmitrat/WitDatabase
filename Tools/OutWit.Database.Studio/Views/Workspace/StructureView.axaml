<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:OutWit.Database.Studio.ViewModels.Tabs"
             xmlns:models="clr-namespace:OutWit.Database.Studio.Models"
             xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
             xmlns:conv="using:OutWit.Database.Studio.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="OutWit.Database.Studio.Views.Workspace.StructureView"
             x:DataType="tabs:StructureTabViewModel">

    <UserControl.Styles>
        <!-- The section strip: radio buttons in behaviour, a segmented strip to look at. The order
             never changes, so the shape of the strip is part of how it is read. -->
        <Style Selector="RadioButton.tab">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="10,6">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.tab:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <Style Selector="RadioButton.tab:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Five sections and a DDL panel that is always there (5.1, WS-38). The strip is at the top and
         its order never changes: people move between these constantly. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: what this is, and what is pending on it -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <!-- Auto for the title and star for the buttons, which is the way round it has to be.
                 It was "*,Auto": the buttons took every pixel they wanted and the title got the
                 remainder - and a horizontal StackPanel neither shrinks nor clips, so it was PAINTED
                 UNDER the buttons. "Пересобрать…" only made it visible; the row was one caption away
                 from it in any language.

                 The buttons wrap now instead of pushing. A toolbar that cannot fit on one line is a
                 toolbar that belongs on two - hiding a command, or drawing it over a name, are both
                 worse than being one row taller. -->
            <Grid ColumnDefinitions="Auto,*">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto"
                      VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="True">
                    <TextBlock Grid.Column="0" Text="{Binding ObjectTypeDisplay}"
                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ObjectName}" FontSize="14" Foreground="Gray"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"
                               ToolTip.Tip="{Binding ObjectName}"/>
                    <Border Grid.Column="2" Background="#FFF3CD" CornerRadius="3" Padding="6,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasPending}">
                        <!-- A count needs a plural rule, not a template, so the LANGUAGE is an input
                             here: it is what makes the badge change when the catalogue is swapped. -->
                        <TextBlock FontSize="11" Foreground="#856404">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static conv:LocalizedText.Plural}"
                                              ConverterParameter="Count.Pending">
                                    <DynamicResource ResourceKey="S.$language"/>
                                    <Binding Path="PendingCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <WrapPanel.Styles>
                        <Style Selector="WrapPanel > Button">
                            <Setter Property="Margin" Value="6,2,0,2"/>
                        </Style>
                    </WrapPanel.Styles>

                    <Button AutomationProperties.AutomationId="StructureAddColumn"
                            Content="{DynamicResource S.Structure.Column}" Command="{Binding AddColumnCommand}"
                            IsVisible="{Binding IsTable}"
                            ToolTip.Tip="{DynamicResource S.Structure.AddColumn.Tip}"/>

                    <Button AutomationProperties.AutomationId="StructureApply"
                            Content="{DynamicResource S.Common.Apply}" Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanApply}" Classes="accent"
                            IsVisible="{Binding IsTable}"/>

                    <Button AutomationProperties.AutomationId="StructureRebuild"
                            Content="{DynamicResource S.Structure.Rebuild}" Command="{Binding RebuildCommand}"
                            IsEnabled="{Binding CanRebuild}"
                            IsVisible="{Binding NeedsRebuild}"
                            ToolTip.Tip="{DynamicResource S.Structure.Rebuild.Tip}"/>

                    <Button AutomationProperties.AutomationId="StructureRevert"
                            Content="{DynamicResource S.Structure.Revert}" Command="{Binding RevertCommand}"
                            IsEnabled="{Binding HasPending}"
                            IsVisible="{Binding IsTable}"/>

                    <Button AutomationProperties.AutomationId="StructureCopyDdl"
                            Content="{DynamicResource S.Structure.CopyDdl}" Command="{Binding CopyDdlCommand}"/>

                    <Button AutomationProperties.AutomationId="StructureRefresh"
                            AutomationProperties.Name="{DynamicResource S.Common.Refresh}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding CanRefresh}"
                            ToolTip.Tip="{DynamicResource S.Common.Refresh}" Width="32" Height="32" Padding="0">
                        <PathIcon Data="{x:Static ui:StudioIcons.TABLE_STRUCTURE_REFRESH}" Width="16" Height="16"/>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- The section strip -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton AutomationProperties.AutomationId="StructureSectionColumns"
                             AutomationProperties.Name="{DynamicResource S.Structure.Section.Columns}"
                             GroupName="StructureSection" Classes="tab"
                             IsChecked="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Columns}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource S.Common.Columns}"/>
                        <TextBlock Text="{Binding ColumnCount}" Foreground="Gray"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton AutomationProperties.AutomationId="StructureSectionKeys"
                             AutomationProperties.Name="{DynamicResource S.Structure.Section.Keys}"
                             GroupName="StructureSection" Classes="tab"
                             IsChecked="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Keys}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource S.Structure.Keys}"/>
                        <TextBlock Text="{Binding Constraints.Count}" Foreground="Gray"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton AutomationProperties.AutomationId="StructureSectionIndexes"
                             AutomationProperties.Name="{DynamicResource S.Structure.Section.Indexes}"
                             GroupName="StructureSection" Classes="tab"
                             IsChecked="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Indexes}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource S.Structure.Indexes}"/>
                        <TextBlock Text="{Binding Indexes.Count}" Foreground="Gray"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton AutomationProperties.AutomationId="StructureSectionTriggers"
                             AutomationProperties.Name="{DynamicResource S.Structure.Section.Triggers}"
                             GroupName="StructureSection" Classes="tab"
                             IsChecked="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Triggers}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource S.Structure.Triggers}"/>
                        <TextBlock Text="{Binding Triggers.Count}" Foreground="Gray"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton AutomationProperties.AutomationId="StructureSectionDdl"
                             AutomationProperties.Name="{DynamicResource S.Structure.Section.Ddl}"
                             GroupName="StructureSection" Classes="tab"
                             IsChecked="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Ddl}">
                    <TextBlock Text="DDL"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- The sections -->
        <Grid Grid.Row="2">

            <!-- Columns -->
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Columns}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <!-- Every heading TRIMS and keeps a gap. Without it a heading longer than its
                         column runs into the next one and the two read as one word - "ОГРАНИЧЕНИЯ"
                         and "ИЗМЕНЕНИЕ" were arriving as "ОГРАНИЧЕНИИЗМЕНЕНИЕ". A caption whose
                         column may be too narrow is a translation away from that in any language. -->
                    <Grid ColumnDefinitions="1.3*,130,70,130,1.7*,96,34">
                        <TextBlock Grid.Column="0" Text="{DynamicResource S.Structure.Head.Name}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource S.Structure.Head.Type}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="NOT NULL" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource S.Structure.Head.Default}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource S.Structure.Head.Constraints}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="5" Text="{DynamicResource S.Structure.Head.Change}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ColumnDraft">
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,4">
                                    <Grid ColumnDefinitions="1.3*,130,70,130,1.7*,96,34">
                                        <TextBox Grid.Column="0" Text="{Binding Name}"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" Text="{Binding DataType}"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center"/>

                                        <CheckBox Grid.Column="2" IsChecked="{Binding !IsNullable}"
                                                  VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="3" Text="{Binding DefaultValue}"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center"/>

                                        <!-- Same shape as the header above: this row of flags cannot
                                             shrink, so it was painting AUTOINCREMENT over the delete
                                             button. It clips at its column now and the whole list is
                                             in the tooltip, so nothing is lost - only cut. -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0" ClipToBounds="True">
                                            <TextBlock Text="PRIMARY KEY" FontSize="11" Foreground="Orange"
                                                       IsVisible="{Binding IsPrimaryKey}"/>
                                            <TextBlock Text="AUTOINCREMENT" FontSize="11" Foreground="Gray"
                                                       IsVisible="{Binding IsAutoIncrement}"/>
                                            <TextBlock Text="UNIQUE" FontSize="11" Foreground="Gray"
                                                       IsVisible="{Binding IsUnique}"/>
                                            <TextBlock Text="{Binding ReferencesTable, StringFormat='-> {0}'}"
                                                       FontSize="11" Foreground="Gray"
                                                       IsVisible="{Binding ReferencesTable, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <TextBlock Text="{DynamicResource S.Structure.Computed}" FontSize="11" Foreground="Gray"
                                                       IsVisible="{Binding IsComputed}"/>
                                            <TextBlock Text="{DynamicResource S.Structure.ToBeDropped}" FontSize="11" Foreground="#B71C1C"
                                                       IsVisible="{Binding IsDeleted}"/>
                                        </StackPanel>

                                        <!-- WS-39: the category, in the row, as soon as the edit is made -->
                                        <Border Grid.Column="5" Background="#FFF3CD" CornerRadius="3"
                                                Padding="6,1" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasMarker}"
                                                ToolTip.Tip="{Binding MarkerReason}">
                                            <TextBlock Text="{Binding Marker}" FontSize="11" Foreground="#856404"/>
                                        </Border>

                                        <Button Grid.Column="6" Width="24" Height="24" Padding="0"
                                                AutomationProperties.AutomationId="StructureDropColumn"
                                                AutomationProperties.Name="{DynamicResource S.Structure.DropColumn}"
                                                Content="✕" FontSize="11"
                                                IsVisible="{Binding !IsDeleted}"
                                                Command="{Binding $parent[ItemsControl].((tabs:StructureTabViewModel)DataContext).DeleteColumnCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{DynamicResource S.Structure.DropColumn}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Keys and constraints -->
            <ScrollViewer IsVisible="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Keys}">
                <StackPanel Spacing="8" Margin="12">
                    <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                            CornerRadius="4" Padding="10"
                            IsVisible="{Binding KeyWarningIsSevere}">
                        <TextBlock Text="{Binding KeyWarning}" TextWrapping="Wrap" Foreground="#856404"/>
                    </Border>

                    <TextBlock Text="{Binding KeyWarning}" TextWrapping="Wrap" Foreground="Gray"
                               IsVisible="{Binding !KeyWarningIsSevere}"/>

                    <ItemsControl ItemsSource="{Binding Constraints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tabs:ConstraintRow">
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid ColumnDefinitions="*,140,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="Gray"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Columns}" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Indexes -->
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Indexes}">
                <Border Grid.Row="0" Padding="12,6"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="StructureCreateIndex"
                                Content="{DynamicResource S.Structure.CreateIndex}" Command="{Binding CreateIndexCommand}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Indexes}" Margin="12,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IndexInfo">
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid ColumnDefinitions="*,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}" Foreground="Gray" FontSize="12"/>
                                            <TextBlock Foreground="Gray" FontSize="11"
                                                       IsVisible="{Binding FilterCondition, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                                        <DynamicResource ResourceKey="S.Structure.PartialIndex"/>
                                                        <Binding Path="FilterCondition"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="{DynamicResource S.Dialog.Trigger.DropAndCreate}" FontSize="11"
                                                AutomationProperties.AutomationId="StructureRecreateIndex"
                                                AutomationProperties.Name="{DynamicResource S.Structure.RecreateIndex}"
                                                Margin="0,0,6,0"
                                                Command="{Binding $parent[ItemsControl].((tabs:StructureTabViewModel)DataContext).RecreateIndexCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{DynamicResource S.Structure.RecreateIndex.Tip}"/>

                                        <Button Grid.Column="3" Content="{DynamicResource S.Common.Drop}" FontSize="11"
                                                AutomationProperties.AutomationId="StructureDropIndex"
                                                AutomationProperties.Name="{DynamicResource S.Structure.DropIndex}"
                                                Command="{Binding $parent[ItemsControl].((tabs:StructureTabViewModel)DataContext).DropIndexCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Triggers -->
            <ScrollViewer IsVisible="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Triggers}">
                <StackPanel Margin="12" Spacing="4">
                    <ItemsControl ItemsSource="{Binding Triggers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TriggerInfo">
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}"/>
                                            <!-- Every part of this line is SQL, including the OF
                                                 clause: a trigger that watches two columns of ten
                                                 reads exactly like one that watches all ten without
                                                 it, and since 2026-08-09 that is a real difference. -->
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="{Binding Timing}"/>
                                                <Run Text="{Binding Event}"/>
                                                <Run Text="{Binding UpdateColumnsClause}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Orientation}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Body}" FontSize="11" Foreground="Gray"
                                                       FontFamily="Consolas,Courier New" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="{DynamicResource S.Common.Edit}" FontSize="11"
                                                    AutomationProperties.AutomationId="StructureEditTrigger"
                                                    AutomationProperties.Name="{DynamicResource S.Structure.EditTrigger}"
                                                    Command="{Binding $parent[ItemsControl].((tabs:StructureTabViewModel)DataContext).EditTriggerCommand}"
                                                    CommandParameter="{Binding}"/>

                                            <Button Content="{DynamicResource S.Common.Drop}" FontSize="11"
                                                    AutomationProperties.AutomationId="StructureDropTrigger"
                                                    AutomationProperties.Name="{DynamicResource S.Structure.DropTrigger}"
                                                    Command="{Binding $parent[ItemsControl].((tabs:StructureTabViewModel)DataContext).DropTriggerCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{DynamicResource S.Structure.CreateTrigger}" FontSize="11"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="StructureCreateTrigger"
                            AutomationProperties.Name="{DynamicResource S.Structure.CreateTrigger}"
                            Command="{Binding CreateTriggerCommand}"/>

                    <TextBlock Text="{DynamicResource S.Structure.TriggerNote}"
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- DDL -->
            <ScrollViewer IsVisible="{Binding SelectedSection, Converter={x:Static tabs:StructureSectionConverter.Instance}, ConverterParameter=Ddl}">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="{Binding FullDdl}"
                               FontFamily="Consolas,Courier New" FontSize="12"
                               TextWrapping="Wrap"/>

                    <!-- A view's whole structure is this text, so it is a box rather than a label: the
                         kind of edit it makes existed, with a category and a sentence describing how it
                         would be carried out, and nothing in the application had ever constructed one. -->
                    <StackPanel Spacing="4" IsVisible="{Binding HasViewDefinition}">
                        <TextBlock Text="{DynamicResource S.Structure.ViewBody}" FontSize="12" Opacity="0.7"/>
                        <TextBox AutomationProperties.AutomationId="StructureViewBody"
                                 AutomationProperties.Name="{DynamicResource S.Structure.ViewBody}"
                                 Text="{Binding ViewDefinition, Mode=TwoWay}"
                                 IsEnabled="{Binding CanEditView}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas,Courier New" FontSize="12"
                                 MinHeight="120"/>
                        <TextBlock Text="{DynamicResource S.Structure.ViewBodyHint}"
                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                   IsVisible="{Binding CanEditView}"/>
                    </StackPanel>

                    <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                            CornerRadius="4" Padding="10"
                            IsVisible="{Binding !CanEditView}">
                        <TextBlock TextWrapping="Wrap" Foreground="#856404"
                                   Text="{DynamicResource S.Structure.ViewNote}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The DDL panel: what Apply will run, always visible while it is being decided (WS-38) -->
        <Border Grid.Row="3"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                MinHeight="90"
                IsVisible="{Binding IsTable}">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="{DynamicResource S.Structure.WillRun}" FontSize="11" FontWeight="SemiBold"
                           Foreground="Gray"/>

                <ScrollViewer Grid.Row="1" MaxHeight="120">
                    <TextBlock Text="{Binding PendingSql}"
                               FontFamily="Consolas,Courier New" FontSize="12"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="4">
                    <!-- Refusals: nothing has been attempted, so they are not errors -->
                    <ItemsControl ItemsSource="{Binding Refusals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#856404" FontSize="11"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Foreground="#B71C1C" FontSize="11"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay: on the content row only, never over the strip or the panel -->
        <Border Grid.Row="2" Background="#80000000" IsVisible="{Binding IsLoading}">
            <TextBlock Text="{DynamicResource S.Structure.Loading}" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>

</UserControl>
