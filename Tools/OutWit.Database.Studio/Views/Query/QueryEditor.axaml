<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:OutWit.Database.Studio.Controls"
             xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
             xmlns:conv="using:OutWit.Database.Studio.Converters"
             xmlns:tabs="clr-namespace:OutWit.Database.Studio.ViewModels.Tabs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OutWit.Database.Studio.Views.Query.QueryEditor"
             x:DataType="tabs:QueryTabViewModel"
             x:Name="Root">

    <!-- No toolbar of its own: the toolbar belongs to the window frame and changes with the active
         tab (WS-8). Two panels of the same buttons is what this replaces. -->
    <Grid RowDefinitions="45*,Auto,55*">

        <!-- SQL Editor. 45/55 by default: once the query is written, the result matters more (3.1) -->
        <Border Grid.Row="0" Background="{DynamicResource Wit.Surface.Bar}" Padding="8">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- ================================ READ-ONLY (WS-10) ================================
                     The refusal is the engine's and it is real; what was missing was any sign of it
                     where writing is typed. A person learned the mode by being refused, or from four
                     English words in the status bar at the other end of the window.

                     Above the editor rather than over it, and it takes a row of its own so it never
                     covers the text it is about. Absent entirely when the connection is writable. -->
                <Border Grid.Row="0"
                        IsVisible="{Binding IsReadOnly}"
                        Background="{DynamicResource Wit.Surface.Panel}"
                        BorderBrush="{DynamicResource Wit.Line}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,5"
                        Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static ui:StudioIcons.COMMON_LOCK}"
                                  Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"
                                  Foreground="{DynamicResource Wit.Ink.Secondary}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.Query.ReadOnly.Banner}"
                                   Foreground="{DynamicResource Wit.Ink.Secondary}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ============================ FIND AND REPLACE (9.7) ============================
                     A band inside the tab, not a window: a modal find dialog covers the very text
                     being searched. It sits ABOVE the editor rather than floating over it, so it
                     never hides a match either. -->
                <Border Grid.Row="1"
                        IsVisible="{Binding Search.IsOpen}"
                        Background="{DynamicResource Wit.Surface.Panel}"
                        CornerRadius="3"
                        Padding="6,4"
                        Margin="0,0,0,6">
                    <StackPanel Spacing="4">

                        <!-- The find row. A GRID rather than one long StackPanel: measured in the
                             running application, the row simply ran off the edge of the editor panel
                             and took the replace and close buttons with it. The design's own spacer
                             is column 1 - what is on the right stays on the right, and what is on the
                             left is allowed to be cut instead of pushing it out of the window. -->
                        <DockPanel LastChildFill="True">

                            <!-- Close is docked FIRST, so it is the one thing that can never be
                                 pushed off the edge - measured in the running application, where it
                                 was, and where a band that cannot be closed is a trap. -->
                            <Button Name="SearchClose"
                                    DockPanel.Dock="Right"
                                    AutomationProperties.AutomationId="SearchClose"
                                    AutomationProperties.Name="{DynamicResource S.Search.Close}"
                                    ToolTip.Tip="{DynamicResource S.Search.Close}"
                                    Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="7,0" Margin="6,0,0,0"
                                    Content="✕"
                                    Command="{Binding Search.CloseCommand}"/>

                            <!-- And the rest WRAPS. The captions change length with the language, so
                                 a single row is a promise this band cannot keep in every one. -->
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                            <PathIcon Data="{x:Static ui:StudioIcons.COMMON_SEARCH}"
                                      Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}" VerticalAlignment="Center"/>

                            <TextBox Name="SearchTerm"
                                     AutomationProperties.AutomationId="SearchTerm"
                                     AutomationProperties.Name="{DynamicResource S.Search.Find}"
                                     Width="160" Height="{DynamicResource Wit.Height.Field}" Padding="6,2"
                                     Watermark="{DynamicResource S.Search.FindPlaceholder}"
                                     Text="{Binding Search.Term, Mode=TwoWay}"/>

                            <ToggleButton Name="SearchMatchCase"
                                          AutomationProperties.AutomationId="SearchMatchCase"
                                          AutomationProperties.Name="{DynamicResource S.Search.MatchCase}"
                                          ToolTip.Tip="{DynamicResource S.Search.MatchCase}"
                                          Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="7,0"
                                          Content="Aa"
                                          IsChecked="{Binding Search.MatchCase, Mode=TwoWay}"/>

                            <ToggleButton Name="SearchRegex"
                                          AutomationProperties.AutomationId="SearchRegex"
                                          AutomationProperties.Name="{DynamicResource S.Search.Regex}"
                                          ToolTip.Tip="{DynamicResource S.Search.Regex}"
                                          Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="7,0"
                                          Content=".*"
                                          IsChecked="{Binding Search.UseRegex, Mode=TwoWay}"/>

                            <ToggleButton Name="SearchWholeWord"
                                          AutomationProperties.AutomationId="SearchWholeWord"
                                          AutomationProperties.Name="{DynamicResource S.Search.WholeWord}"
                                          ToolTip.Tip="{DynamicResource S.Search.WholeWord}"
                                          Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="7,0"
                                          Content="{DynamicResource S.Search.WholeWordShort}"
                                          IsChecked="{Binding Search.WholeWord, Mode=TwoWay}"/>

                            <!-- Where we are, in words. The highlight alone cannot say "2 of 5". -->
                            <TextBlock Name="SearchSummary"
                                       AutomationProperties.AutomationId="SearchSummary"
                                       VerticalAlignment="Center" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.75"
                                       MinWidth="70"
                                       Text="{Binding Search.Summary}"/>

                            <Button Name="SearchPrevious"
                                    AutomationProperties.AutomationId="SearchPrevious"
                                    AutomationProperties.Name="{DynamicResource S.Search.Previous}"
                                    ToolTip.Tip="{DynamicResource S.Search.Previous}"
                                    Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="7,0"
                                    Command="{Binding Search.FindPreviousCommand}">
                                <PathIcon Data="{x:Static ui:StudioIcons.ARROW_UP}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
                            </Button>

                            <Button Name="SearchNext"
                                    AutomationProperties.AutomationId="SearchNext"
                                    AutomationProperties.Name="{DynamicResource S.Search.Next}"
                                    ToolTip.Tip="{DynamicResource S.Search.Next}"
                                    Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="7,0"
                                    Command="{Binding Search.FindNextCommand}">
                                <PathIcon Data="{x:Static ui:StudioIcons.ARROW_DOWN}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
                            </Button>

                            <CheckBox Name="SearchInSelection"
                                      AutomationProperties.AutomationId="SearchInSelection"
                                      AutomationProperties.Name="{DynamicResource S.Search.InSelection}" VerticalAlignment="Center"
                                      Content="{DynamicResource S.Search.InSelection}"
                                      IsChecked="{Binding Search.InSelection, Mode=TwoWay}"/>

                            <Button Name="SearchShowReplace"
                                    AutomationProperties.AutomationId="SearchShowReplace"
                                    AutomationProperties.Name="{DynamicResource S.Search.ShowReplace}"
                                    Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="8,0"
                                    Content="{DynamicResource S.Search.Replace}"
                                    IsVisible="{Binding !Search.IsReplaceMode}"
                                    Command="{Binding Search.ToggleReplaceCommand}"/>

                            </WrapPanel>
                        </DockPanel>

                        <!-- The replace row: the same band, one line taller (9.7) -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding Search.IsReplaceMode}">
                            <PathIcon Data="{x:Static ui:StudioIcons.TAB_TABLE_EDIT}"
                                      Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}" VerticalAlignment="Center"/>

                            <TextBox Name="SearchReplacement"
                                     AutomationProperties.AutomationId="SearchReplacement"
                                     AutomationProperties.Name="{DynamicResource S.Search.ReplacePlaceholder}"
                                     Width="190" Height="{DynamicResource Wit.Height.Field}" Padding="6,2"
                                     Watermark="{DynamicResource S.Search.ReplacePlaceholder}"
                                     Text="{Binding Search.Replacement, Mode=TwoWay}"/>

                            <Button Name="SearchReplaceOne"
                                    AutomationProperties.AutomationId="SearchReplaceOne"
                                    AutomationProperties.Name="{DynamicResource S.Search.ReplaceOne}"
                                    Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="8,0"
                                    Content="{DynamicResource S.Search.ReplaceOne}"
                                    Command="{Binding Search.ReplaceCommand}"/>

                            <Button Name="SearchReplaceAll"
                                    AutomationProperties.AutomationId="SearchReplaceAll"
                                    AutomationProperties.Name="{DynamicResource S.Search.ReplaceAll}"
                                    Height="{DynamicResource Wit.Height.ButtonCompact}" Padding="8,0"
                                    Content="{DynamicResource S.Search.ReplaceAll}"
                                    Command="{Binding Search.ReplaceAllCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <c:SqlEditor Grid.Row="2"
                             SqlText="{Binding SqlText, Mode=TwoWay}"
                             SelectedText="{Binding SelectedText, Mode=OneWayToSource}"
                             SelectionStartInText="{Binding SelectionStart, Mode=TwoWay}"
                             SelectionLengthInText="{Binding SelectionLength, Mode=TwoWay}"
                             CaretOffsetInText="{Binding CaretOffset, Mode=OneWayToSource}"
                             CaretLine="{Binding CaretLine, Mode=OneWayToSource}"
                             CaretColumn="{Binding CaretColumn, Mode=OneWayToSource}"
                             UnderlineLine="{Binding UnderlineLine}"
                             UnderlineColumn="{Binding UnderlineColumn}"
                             UnderlineLength="{Binding UnderlineLength}"
                             CompletionSource="{Binding}"/>

                <!-- What is wrong with the text as it stands, before anything is sent (3.6) -->
                <Border Grid.Row="3"
                        Background="{DynamicResource Wit.Error.Surface}"
                        CornerRadius="3"
                        Padding="8,4"
                        Margin="0,4,0,0"
                        IsVisible="{Binding SyntaxErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                                  Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}" Foreground="{DynamicResource Wit.Error.Text}"/>
                        <!-- One catalogue entry, not three Runs. The message itself is the ENGINE's
                             and stays in its own words (WS-64); only the frame around it is Studio's. -->
                        <TextBlock Foreground="{DynamicResource Wit.Error.Text}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                    <DynamicResource ResourceKey="S.Query.SyntaxError"/>
                                    <Binding Path="SyntaxErrorMessage"/>
                                    <Binding Path="SyntaxErrorLine"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Wit.Surface.Panel}"/>

        <!-- The four permanent tabs of the result panel (3.4) -->
        <TabControl Grid.Row="2"
                    Background="{DynamicResource Wit.Surface.Bar}">

            <!-- ================================ RESULT ================================ -->
            <TabItem Header="{DynamicResource S.Query.Tab.Result}">
                <Grid RowDefinitions="*,Auto">
                    <c:ResultDataGrid Grid.Row="0"
                                      ResultView="{Binding CurrentView}"
                                      ColumnSettings="{Binding ResultColumnSettings}"
                                      SelectedRows="{Binding SelectedRows, Mode=OneWayToSource}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      IsVisible="{Binding HasResults}">

                        <c:ResultDataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem AutomationProperties.AutomationId="QueryEditorCopy" Header="{DynamicResource S.Common.Copy}"
                                          Command="{Binding CopyRowsCommand}"
                                          InputGesture="Ctrl+C">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.COPY}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem AutomationProperties.AutomationId="QueryEditorCopyWithHeaders" Header="{DynamicResource S.Query.Menu.CopyWithHeaders}"
                                          Command="{Binding CopyRowsAsCsvCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.COPY}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem AutomationProperties.AutomationId="QueryEditorCopyAsINSERT" Header="{DynamicResource S.Query.Menu.CopyAsInsert}"
                                          Command="{Binding CopyRowsAsInsertCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.COPY_AS_INSERT}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem AutomationProperties.AutomationId="QueryEditorCopyAllRows" Header="{DynamicResource S.Query.Menu.CopyAllRows}"
                                          Command="{Binding CopyAllRowsCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.COPY}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem AutomationProperties.AutomationId="QueryEditorCopyAllAsINSERT" Header="{DynamicResource S.Query.Menu.CopyAllAsInsert}"
                                          Command="{Binding CopyAllRowsAsInsertCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.COPY_AS_INSERT}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem AutomationProperties.AutomationId="QueryEditorExportResults" Header="{DynamicResource S.Query.Menu.ExportResults}"
                                          Command="{Binding ExportResultsCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.EXPORT}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </c:ResultDataGrid.ContextMenu>

                        <c:ResultDataGrid.KeyBindings>
                            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyRowsCommand}"/>
                        </c:ResultDataGrid.KeyBindings>

                    </c:ResultDataGrid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Wit.Surface.Panel}"
                            Padding="8"
                            IsVisible="{Binding HasResults}">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:LocalizedText.Plural}"
                                                  ConverterParameter="Count.RowsTotal">
                                        <DynamicResource ResourceKey="S.$language"/>
                                        <Binding Path="TotalRowCount"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                        <DynamicResource ResourceKey="S.Status.Elapsed2"/>
                                        <Binding Path="ExecutionTimeMs"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button AutomationProperties.AutomationId="QueryEditorCopySelectedRows"
                                        AutomationProperties.Name="{DynamicResource S.Query.CopyRows}"
                                        Command="{Binding CopyRowsCommand}"
                                        IsEnabled="{Binding CanCopyRows}"
                                        Width="28" Height="{DynamicResource Wit.Height.Button}" Padding="0"
                                        ToolTip.Tip="{DynamicResource S.Query.CopyRows.Tip}">
                                    <PathIcon Data="{x:Static ui:StudioIcons.COPY}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                </Button>
                                <Button AutomationProperties.AutomationId="QueryEditorCopyAsINSERTStatements"
                                        AutomationProperties.Name="{DynamicResource S.Query.CopyAsInsert}"
                                        Command="{Binding CopyRowsAsInsertCommand}"
                                        IsEnabled="{Binding CanCopyRows}"
                                        Width="28" Height="{DynamicResource Wit.Height.Button}" Padding="0"
                                        ToolTip.Tip="{DynamicResource S.Query.CopyAsInsert}">
                                    <PathIcon Data="{x:Static ui:StudioIcons.COPY_AS_INSERT}" Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Zero rows is an answer, not an empty screen (3.4) -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding !HasResults}">
                        <PathIcon Data="{x:Static ui:StudioIcons.DB_TABLE}"
                                  Width="42" Height="42"
                                  Foreground="{DynamicResource Wit.Ink.Muted}"/>
                        <TextBlock Text="{DynamicResource S.Query.NoRows}"
                                   FontSize="{DynamicResource Wit.Font.SectionTitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                        <TextBlock Text="{DynamicResource S.Query.NoRows.Hint}"
                                   FontSize="{DynamicResource Wit.Font.Body}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Wit.Ink.Muted}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================================ MESSAGES ================================ -->
            <TabItem Header="{DynamicResource S.Query.Tab.Messages}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="8">

                        <!-- A line per statement of the script (WS-22) -->
                        <ItemsControl ItemsSource="{Binding Statements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,8,0"
                                                   FontFamily="Consolas,monospace"
                                                   Text="{Binding Number, StringFormat='[{0}]'}"
                                                   Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Wit.Ink.Secondary}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                                    <DynamicResource ResourceKey="S.Query.StatementDetail"/>
                                                    <Binding Path="RowsAffected"/>
                                                    <Binding Path="ExecutionTimeMs"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The failure, with the engine's full text where a person can go and read it (WS-11) -->
                        <Border Background="{DynamicResource Wit.Error.Surface}"
                                BorderBrush="{DynamicResource Wit.Error.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                                              Width="{DynamicResource Wit.Icon.Normal}" Height="{DynamicResource Wit.Icon.Normal}" Foreground="{DynamicResource Wit.Error.Text}"/>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Wit.Error.Text}"/>
                                </StackPanel>

                                <!-- "Did you mean Orders?" - from the schema already loaded (3.6) -->
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding ErrorSuggestion, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Wit.Error.Text}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                                <DynamicResource ResourceKey="S.Query.DidYouMean"/>
                                                <Binding Path="ErrorSuggestion"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button AutomationProperties.AutomationId="QueryEditorApplySuggestion"
                                            AutomationProperties.Name="{DynamicResource S.Query.UseSuggestion}"
                                            Content="{DynamicResource S.Query.Replace}"
                                            Padding="8,2"
                                            Command="{Binding ApplySuggestionCommand}"/>
                                </StackPanel>

                                <Expander Header="{DynamicResource S.Query.EngineSaid}"
                                          IsVisible="{Binding ErrorDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <SelectableTextBlock Text="{Binding ErrorDetail}"
                                                         TextWrapping="Wrap"
                                                         FontFamily="Consolas,monospace"
                                                         FontSize="{DynamicResource Wit.Font.Mono.Data}"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource S.Query.NothingRun}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource Wit.Ink.Muted}"
                                   IsVisible="{Binding !HasExecutionResult}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================ PLAN ================================ -->
            <TabItem Header="{DynamicResource S.Query.Tab.Plan}" IsSelected="{Binding IsPlanSelected, Mode=TwoWay}">
                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Background="{DynamicResource Wit.Surface.Panel}"
                            Padding="10,6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="EXPLAIN"/>

                            <!-- WS-28. Measured: this engine returns id, parent and detail and no
                                 numbers at all - so there is not even an estimate to label. -->
                            <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Wit.Font.Control}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{DynamicResource S.Query.PlanNote}"
                                       Foreground="{DynamicResource Wit.Ink.Secondary}"
                                       Text="{DynamicResource S.Query.PlanNote}"/>

                            <Button Grid.Column="2"
                                    AutomationProperties.AutomationId="QueryEditorShowPlan"
                                    AutomationProperties.Name="{DynamicResource S.Query.Explain.Name}"
                                    Content="{DynamicResource S.Query.Explain}"
                                    Padding="10,3"
                                    Command="{Binding ShowPlanCommand}"/>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1"
                              AutomationProperties.AutomationId="QueryEditorPlanTree"
                              ItemsSource="{Binding Plan.Roots}"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="4">
                        <!-- Open. A plan is only useful whole, and the node worth looking at - the
                             scan - is always the deepest one. Found by running the application: the
                             tree came up showing one word and a chevron. -->
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Spacing="1" Margin="0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border CornerRadius="2" Padding="5,1"
                                                Background="{Binding Kind, Converter={x:Static conv:PlanConverters.KindBrush}}">
                                            <TextBlock Text="{Binding Operator}"
                                                       FontFamily="Consolas,monospace"
                                                       FontSize="{DynamicResource Wit.Font.Mono.Data}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Columns}"
                                                   FontSize="{DynamicResource Wit.Font.Control}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420"
                                                   Foreground="{DynamicResource Wit.Ink.Muted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Warning}"
                                               FontSize="{DynamicResource Wit.Font.Control}"
                                               TextWrapping="Wrap"
                                               MaxWidth="420"
                                               Margin="4,0,0,0"
                                               Foreground="{DynamicResource Wit.Warn.Text}"
                                               IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{DynamicResource Wit.Ink.Secondary}"
                               Text="{Binding PlanMessage}"
                               IsVisible="{Binding PlanMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
            </TabItem>

            <!-- ================================ HISTORY ================================ -->
            <TabItem Header="{DynamicResource S.Query.Tab.History}" IsSelected="{Binding IsHistorySelected, Mode=TwoWay}">
                <Grid RowDefinitions="Auto,*,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8">
                        <TextBox Grid.Column="0"
                                 AutomationProperties.AutomationId="QueryEditorHistorySearch"
                                 AutomationProperties.Name="{DynamicResource S.Query.History.Search.Name}"
                                 Text="{Binding HistorySearch, Mode=TwoWay}"
                                 PlaceholderText="{DynamicResource S.Query.History.Search}"/>
                        <Button Grid.Column="1" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="QueryEditorRefreshHistory"
                                AutomationProperties.Name="{DynamicResource S.Query.History.Refresh.Name}"
                                Content="{DynamicResource S.Query.History.SearchButton}"
                                Command="{Binding RefreshHistoryCommand}"/>
                        <Button Grid.Column="2" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="QueryEditorClearHistory"
                                AutomationProperties.Name="{DynamicResource S.Query.History.Clear.Name}"
                                Content="{DynamicResource S.Toolbar.Clear}"
                                Command="{Binding ClearHistoryCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="1"
                             AutomationProperties.AutomationId="QueryEditorHistoryList"
                             ItemsSource="{Binding History}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,3">
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="Consolas,monospace"
                                               FontSize="{DynamicResource Wit.Font.Mono.Data}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="{DynamicResource Wit.Font.Control}"
                                               Foreground="{DynamicResource Wit.Ink.Secondary}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:LocalizedText.Format}">
                                                <DynamicResource ResourceKey="S.Query.HistoryDetail"/>
                                                <Binding Path="Status"/>
                                                <Binding Path="Rows"/>
                                                <Binding Path="DurationMs"/>
                                                <Binding Path="ExecutedAt"/>
                                                <Binding Path="Connection"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{DynamicResource Wit.Ink.Secondary}"
                               Text="{Binding HistoryMessage}"
                               IsVisible="{Binding HistoryMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <Border Grid.Row="2" Padding="8,4"
                            Background="{DynamicResource Wit.Surface.Panel}">
                        <TextBlock FontSize="{DynamicResource Wit.Font.Control}"
                                   Foreground="{DynamicResource Wit.Ink.Secondary}"
                                   Text="{DynamicResource S.Query.History.Note}"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
