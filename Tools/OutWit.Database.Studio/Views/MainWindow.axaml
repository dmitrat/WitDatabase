<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        xmlns:views="using:OutWit.Database.Studio.Views"
        xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:workspace="clr-namespace:OutWit.Database.Studio.Views.Workspace"
        xmlns:services="using:OutWit.Database.Studio.Services"
        xmlns:converters="using:OutWit.Database.Studio.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="OutWit.Database.Studio.Views.MainWindow"
        x:DataType="vm:ApplicationViewModel"
        Title="{Binding MainWindowVm.Title}"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="560"

        Background="{DynamicResource Wit.Surface.Base}">

	<!-- Keyboard (1.7). Ctrl+N used to open a query TAB, which no other application means by it;
	     it now creates a database and the tab is Ctrl+T. F5 no longer means two things at once -
	     it runs the statement under the cursor (WS-25) and refreshing the schema is Ctrl+R. -->
	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+K" Command="{Binding PaletteVm.OpenCommand}"/>
		<KeyBinding Gesture="Ctrl+T" Command="{Binding WorkspaceTabsVm.NewQueryTabCommand}"/>
		<KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding WorkspaceTabsVm.ReopenClosedTabCommand}"/>
		<KeyBinding Gesture="Ctrl+W" Command="{Binding WorkspaceTabsVm.CloseTabCommand}" CommandParameter="{Binding WorkspaceTabsVm.SelectedTab}"/>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding MainWindowVm.NewDatabaseCommand}"/>
		<KeyBinding Gesture="Ctrl+O" Command="{Binding MainWindowVm.OpenDatabaseCommand}"/>
		<KeyBinding Gesture="Ctrl+R" Command="{Binding MainWindowVm.RefreshCommand}"/>
		<KeyBinding Gesture="F5" Command="{Binding WorkspaceTabsVm.ExecuteCurrentStatementCommand}"/>
		<KeyBinding Gesture="Ctrl+Shift+F5" Command="{Binding WorkspaceTabsVm.ExecuteQueryCommand}"/>
		<KeyBinding Gesture="Ctrl+Return" Command="{Binding WorkspaceTabsVm.ExecuteSelectionCommand}"/>
		<KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding WorkspaceTabsVm.SelectedQueryTab.FormatCommand}"/>
		<KeyBinding Gesture="Ctrl+S" Command="{Binding WorkspaceTabsVm.SaveTabCommand}"/>
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding WorkspaceTabsVm.SaveTabAsCommand}"/>
	</Window.KeyBindings>

	<!-- Five zones (1.1): title bar, contextual toolbar, connections + workspace, status bar.
	     The palette and the notification list sit on top of all of it. -->
	<Grid RowDefinitions="Auto,Auto,*,Auto">
		<!--
		    A. The title bar (1.2): menu, command palette, notifications, theme. 38 px, and on
		    `Surface.Bar` - section 8.1 puts the title bar, the menus and the popovers on the same
		    surface, one step above the panels.

		    WS-2 ASKS FOR THIS ROW TO BE THE WINDOW'S CAPTION and it is not, deliberately. Extending
		    the client area was tried here and MEASURED: `ExtendClientAreaToDecorationsHint="True"`
		    with `PreferSystemChrome` at a 38 px hint, and again at the system hint (-1), changes
		    nothing on this Avalonia 12.1.1 / Windows 11 build - the system caption stays, the row
		    stays below it, and the window looks pixel for pixel as it did. `MainWindow` is a plain
		    `Window` with nothing overriding the properties, so there is no local cause to remove.

		    Phase 14 recorded this as "not verifiable on this machine". It is verifiable now, and what
		    the verification says is that the hints do not apply - which is a different and more useful
		    fact. It is not worth hand-drawing minimise, maximise and close (and with them snap
		    layouts, double-click maximise and the system menu) to chase it.
		-->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
		      Height="{DynamicResource Wit.Height.TitleBar}"
		      Background="{DynamicResource Wit.Surface.Bar}">
			<!-- Menu -->
			<Menu Grid.Column="0" VerticalAlignment="Center">
				<MenuItem AutomationProperties.AutomationId="MainWindowFile" Header="{DynamicResource S.Menu.File}">
					<MenuItem AutomationProperties.AutomationId="MainWindowNewQueryTab" Header="{DynamicResource S.Menu.NewQueryTab}"
					          Command="{Binding WorkspaceTabsVm.NewQueryTabCommand}"
					          InputGesture="Ctrl+N">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.TAB_NEW}" />
						</MenuItem.Icon>
					</MenuItem>

					<Separator />

					<MenuItem AutomationProperties.AutomationId="MainWindowNewDatabase" Header="{DynamicResource S.Menu.NewDatabase}"
					          Command="{Binding MainWindowVm.NewDatabaseCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_NEW_DATABASE}" />
						</MenuItem.Icon>
					</MenuItem>

					<!-- The saved connections (WS-68): what "recent files" becomes once several
					     databases can be open at once. -->
					<MenuItem AutomationProperties.AutomationId="MainWindowConnections" Header="{DynamicResource S.Menu.Connections}"
					          Command="{Binding MainWindowVm.ConnectionsCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_OPEN_DATABASE}" />
						</MenuItem.Icon>
					</MenuItem>

					<MenuItem AutomationProperties.AutomationId="MainWindowOpenDatabase" Header="{DynamicResource S.Menu.OpenDatabase}"
					          Command="{Binding MainWindowVm.OpenDatabaseCommand}"
					          InputGesture="Ctrl+O">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_OPEN_DATABASE}" />
						</MenuItem.Icon>
					</MenuItem>

					<MenuItem AutomationProperties.AutomationId="MainWindowCloseDatabase" Header="{DynamicResource S.Menu.CloseDatabase}"
					          Command="{Binding MainWindowVm.CloseDatabaseCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_CLOSE_DATABASE}" />
						</MenuItem.Icon>
					</MenuItem>

					<Separator />

					<MenuItem AutomationProperties.AutomationId="MainWindowSaveQuery" Header="{DynamicResource S.Menu.SaveQuery}"
					          Command="{Binding WorkspaceTabsVm.SaveTabCommand}"
					          InputGesture="Ctrl+S">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.QUERY_SAVE}" />
						</MenuItem.Icon>
					</MenuItem>

					<MenuItem AutomationProperties.AutomationId="MainWindowSaveQueryAs" Header="{DynamicResource S.Menu.SaveQueryAs}"
					          Command="{Binding WorkspaceTabsVm.SaveTabAsCommand}"
					          InputGesture="Ctrl+Shift+S">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.QUERY_SAVE}" />
						</MenuItem.Icon>
					</MenuItem>

					<Separator />

					<MenuItem AutomationProperties.AutomationId="MainWindowRecentFilesMenu" x:Name="RecentFilesMenu"
					          Header="{DynamicResource S.Menu.RecentFiles}"
					          IsEnabled="{Binding MainWindowVm.HasRecentFiles}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_RECENT_FILES}" />
						</MenuItem.Icon>
					</MenuItem>

					<MenuItem AutomationProperties.AutomationId="MainWindowClearRecentFiles" Header="{DynamicResource S.Menu.ClearRecentFiles}"
					          Command="{Binding MainWindowVm.ClearRecentFilesCommand}"
					          IsEnabled="{Binding MainWindowVm.HasRecentFiles}"/>

					<Separator />

					<MenuItem AutomationProperties.AutomationId="MainWindowEXit" Header="{DynamicResource S.Menu.Exit}"
					          Command="{Binding MainWindowVm.ExitCommand}"
					          InputGesture="Alt+F4">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_EXIT}" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<MenuItem AutomationProperties.AutomationId="MainWindowEdit" Header="{DynamicResource S.Menu.Edit}">
					<MenuItem AutomationProperties.AutomationId="MainWindowCopy" Header="{DynamicResource S.Menu.Copy}" InputGesture="Ctrl+C">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_COPY}" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem AutomationProperties.AutomationId="MainWindowPaste" Header="{DynamicResource S.Menu.Paste}" InputGesture="Ctrl+V">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_PASTE}" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator/>
					<MenuItem AutomationProperties.AutomationId="MainWindowSettings" Header="{DynamicResource S.Menu.Settings}"
					          Command="{Binding MainWindowVm.SettingsCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_ABOUT}" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<MenuItem AutomationProperties.AutomationId="MainWindowQuery" Header="{DynamicResource S.Menu.Query}">
					<MenuItem AutomationProperties.AutomationId="MainWindowExecute" Header="{DynamicResource S.Menu.Execute}"
					          Command="{Binding WorkspaceTabsVm.ExecuteQueryCommand}"
					          InputGesture="F5">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.QUERY_EXECUTE}" />
						</MenuItem.Icon>
					</MenuItem>

					<MenuItem AutomationProperties.AutomationId="MainWindowExecuteSelection" Header="{DynamicResource S.Menu.ExecuteSelection}"
					          Command="{Binding WorkspaceTabsVm.ExecuteSelectionCommand}"
					          InputGesture="Ctrl+Enter">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.QUERY_EXECUTE}" />
						</MenuItem.Icon>
					</MenuItem>

					<Separator />

					<MenuItem AutomationProperties.AutomationId="MainWindowClearResults" Header="{DynamicResource S.Menu.ClearResults}"
					          Command="{Binding WorkspaceTabsVm.ClearResultsCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.QUERY_CLEAR}" />
						</MenuItem.Icon>
					</MenuItem>

					<Separator />

					<MenuItem AutomationProperties.AutomationId="MainWindowCloseTab" Header="{DynamicResource S.Menu.CloseTab}"
					          Command="{Binding WorkspaceTabsVm.CloseTabCommand}"
					          CommandParameter="{Binding WorkspaceTabsVm.SelectedTab}"
					          InputGesture="Ctrl+W">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.TAB_CLOSE}" />
						</MenuItem.Icon>
					</MenuItem>

					<MenuItem AutomationProperties.AutomationId="MainWindowCloseAllTabs" Header="{DynamicResource S.Menu.CloseAllTabs}"
					          Command="{Binding WorkspaceTabsVm.CloseAllTabsCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.TAB_CLOSE}" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<MenuItem AutomationProperties.AutomationId="MainWindowView" Header="{DynamicResource S.Menu.View}">
					<MenuItem AutomationProperties.AutomationId="MainWindowRefresh" Header="{DynamicResource S.Menu.Refresh}"
					          Command="{Binding MainWindowVm.RefreshCommand}"
					          InputGesture="F5">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_REFRESH}" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<MenuItem AutomationProperties.AutomationId="MainWindowTools" Header="{DynamicResource S.Menu.Tools}">
					<MenuItem AutomationProperties.AutomationId="MainWindowExport" Header="{DynamicResource S.Menu.Export}"
					          Command="{Binding MainWindowVm.ExportCommand}"
					          IsEnabled="{Binding MainWindowVm.IsConnected}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_EXPORT}" />
		                </MenuItem.Icon>
					</MenuItem>
					<!-- The whole database as a WitSQL script (WS-51). A byte copy is a different
					     thing and belongs in the Database tab. -->
					<MenuItem AutomationProperties.AutomationId="MainWindowDumpDatabase" Header="{DynamicResource S.Menu.DumpDatabase}"
					          Command="{Binding MainWindowVm.DumpDatabaseCommand}"/>

					<MenuItem AutomationProperties.AutomationId="MainWindowImport" Header="{DynamicResource S.Menu.Import}"
					          Command="{Binding MainWindowVm.ImportCommand}"
					          IsEnabled="{Binding MainWindowVm.IsConnected}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_IMPORT}" />
		                </MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<MenuItem AutomationProperties.AutomationId="MainWindowHelp" Header="{DynamicResource S.Menu.Help}">
					<MenuItem AutomationProperties.AutomationId="MainWindowKeyboardHelp"
					          Header="{DynamicResource S.Keys.Title}"
					          Command="{Binding MainWindowVm.KeyboardHelpCommand}"/>
					<MenuItem AutomationProperties.AutomationId="MainWindowAbout" Header="{DynamicResource S.Menu.About}"
					          Command="{Binding MainWindowVm.AboutCommand}">
						<MenuItem.Icon>
							<PathIcon Data="{x:Static ui:StudioIcons.MENU_ABOUT}" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>
			</Menu>

			<!-- Command palette entry (WS-9). Always in the middle, always in the same place. -->
			<Button AutomationProperties.AutomationId="MainWindowCommandPalette"
			        AutomationProperties.Name="{DynamicResource S.Shell.Palette}"
			        Grid.Column="1"
			        Command="{Binding PaletteVm.OpenCommand}"
			        HorizontalAlignment="Center"
			        VerticalAlignment="Center"
			        MinWidth="320"
			        Height="{DynamicResource Wit.Height.ButtonCompact}"
			        Padding="10,0"
			        Background="{DynamicResource Wit.Surface.Sunken}"
			        BorderThickness="1"
			        CornerRadius="6">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<PathIcon Grid.Column="0" Data="{x:Static ui:StudioIcons.COMMON_SEARCH}"
					          Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}" Opacity="0.6"/>
					<TextBlock Grid.Column="1" Text="{DynamicResource S.Shell.Palette}"
					           Margin="8,0" FontSize="{DynamicResource Wit.Font.Body}" Opacity="0.6" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.45"
					           VerticalAlignment="Center"/>
				</Grid>
			</Button>

			<!-- Right cluster: notifications, theme -->
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
				<Button AutomationProperties.AutomationId="MainWindowNotifications"
				        AutomationProperties.Name="{DynamicResource S.Shell.Notifications}"
				        ToolTip.Tip="{DynamicResource S.Shell.Notifications}"
				        Background="Transparent"
				        BorderThickness="0"
				        Padding="10,4"
				        Command="{Binding MainWindowVm.ShowNotificationsCommand}">
					<Panel>
						<PathIcon Data="{x:Static ui:StudioIcons.COMMON_BELL}" Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
						<Ellipse Width="7" Height="7"
						         Fill="{DynamicResource Wit.Accent}"
						         HorizontalAlignment="Right" VerticalAlignment="Top"
						         Margin="0,-2,-3,0"
						         IsVisible="{Binding MainWindowVm.HasUnreadNotifications}"/>
					</Panel>
				</Button>

				<Button AutomationProperties.AutomationId="MainWindowThemeToggleButton" AutomationProperties.Name="{DynamicResource S.Shell.ToggleTheme}"
				        x:Name="ThemeToggleButton"
				        ToolTip.Tip="{DynamicResource S.Shell.ToggleTheme}"
				        Background="Transparent"
				        BorderThickness="0"
				        Padding="12,6"
				        Margin="0,0,8,0"
				        VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<PathIcon x:Name="ThemeIcon" Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"/>
						<TextBlock x:Name="ThemeText" VerticalAlignment="Center" FontSize="{DynamicResource Wit.Font.Body}"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- B. Contextual toolbar (WS-8): belongs to the active tab and changes with it. The chip on
		     the right is the connection the tab runs in - the one thing that answers "where is this
		     DELETE going" (WS-3). -->
		<Border Grid.Row="1" Height="36"
		        IsVisible="{Binding MainWindowVm.IsConnected}"
		        Background="{DynamicResource Wit.Surface.Panel}"
		        BorderBrush="{DynamicResource Wit.Line}"
		        BorderThickness="0,1,0,1"
		        Padding="8,0">
			<Grid ColumnDefinitions="*,Auto">
				<!--
				    THE ACTIONS SCROLL, THE CHIP DOES NOT. A `StackPanel` in a star column does not
				    clip: with icons beside the captions the query band grew past the window and
				    "Откатить" ran underneath the connection chip - which is the one thing on this row
				    that must never be covered, because it answers "where is this DELETE going" (WS-3).
				    The scroll viewer bounds the actions; the chip keeps its Auto column.

				    WS-8 says a toolbar holds no more than seven buttons and the query band holds
				    twelve. Cutting it to seven is a product decision, not a layout fix, so it is not
				    made here - but the overflow it causes no longer eats the chip.
				-->
				<ScrollViewer Grid.Column="0"
				              HorizontalScrollBarVisibility="Auto"
				              VerticalScrollBarVisibility="Disabled">
				<StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
					<!-- Query tab -->
					<StackPanel Orientation="Horizontal" Spacing="4"
					            IsVisible="{Binding WorkspaceTabsVm.IsQueryTabSelected}">
						<!--
						    AN ICON AND A WORD, ON THE BAR ITSELF. Seven filled rectangles read as a
						    form; seven glyphs with captions read as a row of actions, which is what
						    WS-8 asks the toolbar to be. The icon is not decoration here either -
						    "Выполнить" and "Скрипт" are one statement and the whole file, and at a
						    glance the glyph is the only thing that tells them apart.
						-->
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarExecute" AutomationProperties.Name="{DynamicResource S.Toolbar.Execute}"
						        Command="{Binding WorkspaceTabsVm.ExecuteCurrentStatementCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.CanExecuteQuery}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Execute.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_EXECUTE}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Execute}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarExecuteScript" AutomationProperties.Name="{DynamicResource S.Toolbar.Script.Name}"
						        Command="{Binding WorkspaceTabsVm.ExecuteQueryCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.CanExecuteQuery}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Script.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_EXECUTE_SCRIPT}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Script}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarExecuteSelection" AutomationProperties.Name="{DynamicResource S.Toolbar.Selection.Name}"
						        Command="{Binding WorkspaceTabsVm.ExecuteSelectionCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.CanExecuteQuery}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Selection.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_EXECUTE_SELECTION}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Selection}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarStop" AutomationProperties.Name="{DynamicResource S.Toolbar.Stop}"
						        Command="{Binding WorkspaceTabsVm.CurrentExecutingTab.StopQueryCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.IsExecuting}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Stop.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_STOP}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Stop}"/>
							</StackPanel>
						</Button>

						<Rectangle Classes="toolbar-separator"/>

						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarClearResults" AutomationProperties.Name="{DynamicResource S.Toolbar.Clear.Name}"
						        Command="{Binding WorkspaceTabsVm.ClearResultsCommand}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Clear.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_CLEAR}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Clear}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarFormat" AutomationProperties.Name="{DynamicResource S.Toolbar.Format}"
						        Command="{Binding WorkspaceTabsVm.SelectedQueryTab.FormatCommand}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Format.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_FORMAT}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Format}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarExplain" AutomationProperties.Name="{DynamicResource S.Query.Explain}"
						        Command="{Binding WorkspaceTabsVm.SelectedQueryTab.ShowPlanCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.CanExecuteQuery}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Plan.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_PLAN}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Plan}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarSaveQuery" AutomationProperties.Name="{DynamicResource S.Toolbar.Save.Name}"
						        Command="{Binding WorkspaceTabsVm.SaveTabCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.CanSaveTab}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Save.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_SAVE}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Save}"/>
							</StackPanel>
						</Button>

						<!-- The transaction is the connection's, and the toolbar is where it is decided
						     (WS-26). Autocommit until somebody presses Begin. -->
						<Rectangle Classes="toolbar-separator"/>

						<ComboBox AutomationProperties.AutomationId="ToolbarIsolation"
						          AutomationProperties.Name="{DynamicResource S.Toolbar.Isolation}"
						          ItemsSource="{Binding WorkspaceTabsVm.SelectedQueryTab.Isolations}"
						          SelectedItem="{Binding WorkspaceTabsVm.SelectedQueryTab.Isolation, Mode=TwoWay}"
						          IsEnabled="{Binding !WorkspaceTabsVm.SelectedQueryTab.HasOpenTransaction}"
						          ToolTip.Tip="{DynamicResource S.Toolbar.Isolation.Tip}"
						          Height="{DynamicResource Wit.Height.Field}" MinWidth="130"/>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarBeginTransaction" AutomationProperties.Name="{DynamicResource S.Toolbar.Begin.Name}"
						        Command="{Binding WorkspaceTabsVm.SelectedQueryTab.BeginTransactionCommand}"
						        IsEnabled="{Binding !WorkspaceTabsVm.SelectedQueryTab.HasOpenTransaction}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Begin.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.QUERY_TRANSACTION}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Begin}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar"
						        AutomationProperties.AutomationId="ToolbarCommitTransaction" AutomationProperties.Name="{DynamicResource S.Toolbar.Commit.Name}"
						        Command="{Binding WorkspaceTabsVm.SelectedQueryTab.CommitTransactionCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.SelectedQueryTab.HasOpenTransaction}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Commit.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.TABLE_EDITOR_COMMIT}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Commit}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar danger"
						        AutomationProperties.AutomationId="ToolbarRollbackTransaction" AutomationProperties.Name="{DynamicResource S.Toolbar.Rollback.Name}"
						        Command="{Binding WorkspaceTabsVm.SelectedQueryTab.RollbackTransactionCommand}"
						        IsEnabled="{Binding WorkspaceTabsVm.SelectedQueryTab.HasOpenTransaction}"
						        ToolTip.Tip="{DynamicResource S.Toolbar.Rollback.Tip}">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<PathIcon Data="{x:Static ui:StudioIcons.TABLE_EDITOR_ROLLBACK}" Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"/>
								<TextBlock Text="{DynamicResource S.Toolbar.Rollback}"/>
							</StackPanel>
						</Button>
					</StackPanel>

					<!-- Data tab -->
					<StackPanel Orientation="Horizontal" Spacing="4"
					            IsVisible="{Binding WorkspaceTabsVm.IsTableEditTabSelected}">
						<TextBlock Text="{DynamicResource S.Tab.Data}" FontSize="{DynamicResource Wit.Font.Body}" VerticalAlignment="Center" Opacity="0.6"/>
					</StackPanel>

					<!-- Structure tab -->
					<StackPanel Orientation="Horizontal" Spacing="4"
					            IsVisible="{Binding WorkspaceTabsVm.IsStructureTabSelected}">
						<TextBlock Text="{DynamicResource S.Tab.Structure}" FontSize="{DynamicResource Wit.Font.Body}" VerticalAlignment="Center" Opacity="0.6"/>
					</StackPanel>

					<!-- Database tab. The fourth kind, and it had no band: the query toolbar hides and
					     nothing took its place, so the strip was empty across the window. -->
					<StackPanel Orientation="Horizontal" Spacing="4"
					            IsVisible="{Binding WorkspaceTabsVm.IsDatabaseTabSelected}">
						<TextBlock Text="{DynamicResource S.Tab.Database}" FontSize="{DynamicResource Wit.Font.Body}" VerticalAlignment="Center" Opacity="0.6"/>
					</StackPanel>
				</StackPanel>
				</ScrollViewer>

				<!-- The connection chip of the ACTIVE TAB -->
				<Border Grid.Column="1"
				        IsVisible="{Binding WorkspaceTabsVm.SelectedTab.ConnectionName, Converter={x:Static ObjectConverters.IsNotNull}}"
				        Background="{DynamicResource Wit.Surface.Sunken}"
				        CornerRadius="999"
				        Padding="10,2"
				        VerticalAlignment="Center">
					<TextBlock AutomationProperties.AutomationId="ToolbarConnectionChip"
					           Text="{Binding WorkspaceTabsVm.SelectedTab.ConnectionName}"
					           FontSize="{DynamicResource Wit.Font.Control}"
					           VerticalAlignment="Center"/>
				</Border>
			</Grid>
		</Border>

		<!-- Основной контент с разделителем -->
		<!-- The last two columns take no width while the inspector is hidden: a collapsed control does
		     not collapse its column, and 324 reserved pixels read as the window being off-centre. -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="{Binding MainWindowVm.IsConnected, Converter={x:Static converters:PanelConverters.SplitterWidth}}"/>
				<ColumnDefinition Width="{Binding MainWindowVm.IsConnected, Converter={x:Static converters:PanelConverters.InspectorWidth}}"/>
			</Grid.ColumnDefinitions>
			<!-- Обозреватель баз данных -->
			<Border Grid.Column="0"
                    BorderBrush="{DynamicResource Wit.Line}"
                    BorderThickness="0,0,1,0">
				<views:DatabaseExplorer/>
			</Border>

			<!-- Разделитель -->
			<GridSplitter Grid.Column="1"
                         Width="4"
                         Background="{DynamicResource Wit.Line}"
                         ResizeDirection="Columns"/>

			<!-- Основная область контента -->
			<Grid Grid.Column="2">
				<!-- Welcome Screen (when not connected) -->
				<Grid IsVisible="{Binding !MainWindowVm.IsConnected}">
					
					<!-- Two-column layout: Actions left, Recent right -->
					<Grid ColumnDefinitions="*,Auto,*" 
					      HorizontalAlignment="Center"
					      VerticalAlignment="Center"
					      MaxWidth="700">
						
						<!-- Left: Main Actions -->
						<StackPanel Grid.Column="0" 
						            Spacing="16"
						            VerticalAlignment="Center"
						            HorizontalAlignment="Center">
							
							<!-- Logo -->
							<Border Width="72" Height="72"
							        Background="{DynamicResource Wit.Accent}"
							        CornerRadius="36"
							        HorizontalAlignment="Center">
								<PathIcon Data="{x:Static ui:StudioIcons.DB_TABLE}"
								          Width="36" Height="36"
								          Foreground="White"/>
							</Border>

							<!-- Title -->
							<TextBlock Text="WitDatabase Studio"
							           HorizontalAlignment="Center"
							           FontSize="{DynamicResource Wit.Font.WindowTitle}"
							           FontWeight="SemiBold"/>

							<!-- Subtitle -->
							<TextBlock Text="{DynamicResource S.Welcome.Subtitle}"
							           HorizontalAlignment="Center"
							           FontSize="{DynamicResource Wit.Font.BlockTitle}"
							           Foreground="Gray"/>

							<!-- Action Buttons -->
							<StackPanel Spacing="12" Margin="0,16,0,0">
								<Button AutomationProperties.AutomationId="WelcomeNewDatabase" AutomationProperties.Name="{DynamicResource S.Welcome.NewDatabase}" Command="{Binding MainWindowVm.NewDatabaseCommand}"
								        Width="180"
								        HorizontalContentAlignment="Left"
								        Padding="16,10">
									<StackPanel Orientation="Horizontal" Spacing="12">
										<PathIcon Data="{x:Static ui:StudioIcons.MENU_NEW_DATABASE}"
										          Width="{DynamicResource Wit.Icon.Large}" Height="{DynamicResource Wit.Icon.Large}"/>
										<TextBlock Text="{DynamicResource S.Welcome.NewDatabase}" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
								
								<Button AutomationProperties.AutomationId="WelcomeOpenDatabase" AutomationProperties.Name="{DynamicResource S.Welcome.OpenDatabase}" Command="{Binding MainWindowVm.OpenDatabaseCommand}"
								        Width="180"
								        HorizontalContentAlignment="Left"
								        Padding="16,10"
								        Classes="accent">
									<StackPanel Orientation="Horizontal" Spacing="12">
										<PathIcon Data="{x:Static ui:StudioIcons.MENU_OPEN_DATABASE}"
										          Width="{DynamicResource Wit.Icon.Large}" Height="{DynamicResource Wit.Icon.Large}"/>
										<TextBlock Text="{DynamicResource S.Welcome.OpenDatabase}" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
							</StackPanel>

							<!-- Hint -->
							<TextBlock Text="Ctrl+O"
							           HorizontalAlignment="Center"
							           FontSize="{DynamicResource Wit.Font.Control}"
							           Foreground="Gray"
							           Opacity="0.7"
							           Margin="0,8,0,0"/>
						</StackPanel>

						<!-- Separator (only when recent files exist) -->
						<Border Grid.Column="1"
						        Width="1"
						        Background="{DynamicResource Wit.Line}"
						        Margin="40,20"
						        IsVisible="{Binding MainWindowVm.HasRecentFiles}"/>

						<!-- Right: Recent Files -->
						<StackPanel Grid.Column="2"
						            x:Name="RecentFilesPanel"
						            IsVisible="{Binding MainWindowVm.HasRecentFiles}"
						            Spacing="8"
						            VerticalAlignment="Center"
						            MinWidth="200">
							
							<TextBlock Text="{DynamicResource S.Welcome.Recent}"
							           FontSize="{DynamicResource Wit.Font.SectionTitle}"
							           FontWeight="SemiBold"
							           Foreground="Gray"
							           Margin="0,0,0,8"/>
							
							<!-- Recent files will be added here dynamically -->
							<!-- Using ScrollViewer to handle many items -->
							<ScrollViewer MaxHeight="300"
							              HorizontalScrollBarVisibility="Disabled"
							              VerticalScrollBarVisibility="Auto">
								<StackPanel x:Name="RecentFilesList" Spacing="4"/>
							</ScrollViewer>
							
							<Button AutomationProperties.AutomationId="MainWindowClearRecent" Content="{DynamicResource S.Settings.ClearRecent}"
							        Command="{Binding MainWindowVm.ClearRecentFilesCommand}"
							        Classes="hyperlink"
							        HorizontalAlignment="Left"
							        Margin="0,8,0,0"
							        Foreground="Gray"/>
						</StackPanel>
					</Grid>
				</Grid>

				<!-- Unified Workspace Tabs (when connected) -->
				<workspace:WorkspaceTabs DataContext="{Binding WorkspaceTabsVm}"
				                         IsVisible="{Binding $parent[Window].((vm:ApplicationViewModel)DataContext).MainWindowVm.IsConnected}"/>
			</Grid>

			<!-- The right panel the frame reserved (WS-12), now the object inspector (WS-18). It
			     follows the selection in the tree and answers "what is this" without opening a tab. -->
			<GridSplitter Grid.Column="3"
			              Width="4"
			              Background="{DynamicResource Wit.Line}"
			              ResizeDirection="Columns"
			              IsVisible="{Binding MainWindowVm.IsConnected}"/>

			<Border Grid.Column="4"
			        BorderBrush="{DynamicResource Wit.Line}"
			        BorderThickness="1,0,0,0"
			        IsVisible="{Binding MainWindowVm.IsConnected}">
				<views:ObjectInspector DataContext="{Binding InspectorVm}"/>
			</Border>
		</Grid>

		<!-- E. Status bar (1.5). Left: where we are. Middle: what is happening right now, and a way
		     to stop it (WS-6). Right: where the cursor is. -->
		<Border Grid.Row="3"
                Background="{DynamicResource Wit.Surface.Bar}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,1,0,0"
                Padding="8,2"
                MinHeight="25">
			<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
				<!-- Where we are -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
				            IsVisible="{Binding MainWindowVm.IsConnected}">
					<!-- A MARKER, not a drawing: `dot` fills it. Without the class an outline dot is a
					     RING, which reads as a different state from "connected". And the colour is the
					     accent rather than `LimeGreen` - the last named colour left in this file. -->
					<PathIcon Classes="dot"
					          Data="{x:Static ui:StudioIcons.COMMON_BULLET}"
					          Width="{DynamicResource Wit.Icon.InLine}" Height="{DynamicResource Wit.Icon.InLine}"
					          Foreground="{DynamicResource Wit.Accent}"
					          VerticalAlignment="Center"/>
					<TextBlock AutomationProperties.AutomationId="StatusConnection"
					           Text="{Binding MainWindowVm.ConnectionSummary}"
					           FontSize="{DynamicResource Wit.Font.Body}"
					           MaxWidth="440"
					           TextTrimming="CharacterEllipsis"
					           VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Grid.Column="1"
				           AutomationProperties.AutomationId="StatusEngine"
				           Text="{Binding MainWindowVm.EngineSummary}"
				           Margin="12,0,0,0"
				           FontSize="{DynamicResource Wit.Font.Body}"
				           Opacity="0.65"
				           VerticalAlignment="Center"
				           IsVisible="{Binding MainWindowVm.IsConnected}"/>

				<!-- What is happening. A long operation does not block the window: other tabs keep
				     working and this is where it is stopped (WS-6). -->
				<!-- A Grid rather than a centred StackPanel: a StackPanel takes the width it wants and
				     draws over its neighbours when it cannot have it, and the connection summary
				     carries a full file path, so on a real database there is nothing left for this
				     column. Found by running the application - "B-Tree" and "Autocommit" were being
				     drawn on top of by the status text. -->
				<Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" ClipToBounds="True"
				      VerticalAlignment="Center">
					<ProgressBar Grid.Column="0" IsIndeterminate="True" Width="90" Height="3"
					             Margin="0,0,8,0"
					             VerticalAlignment="Center"
					             IsVisible="{Binding WorkspaceTabsVm.IsExecuting}"/>
					<TextBlock Grid.Column="1"
					           AutomationProperties.AutomationId="StatusActivity"
					           Text="{Binding MainWindowVm.StatusText}"
					           FontSize="{DynamicResource Wit.Font.Body}"
					           TextAlignment="Center"
					           TextTrimming="CharacterEllipsis"
					           VerticalAlignment="Center"/>
					<Button Grid.Column="2"
					        AutomationProperties.AutomationId="StatusCancel" AutomationProperties.Name="{DynamicResource S.Common.Cancel}"
					        Content="{DynamicResource S.Common.Cancel}"
					        Padding="8,0"
					        Height="{DynamicResource Wit.Height.ButtonCompact}"
					        Margin="8,0,0,0"
					        IsVisible="{Binding WorkspaceTabsVm.IsExecuting}"
					        Command="{Binding WorkspaceTabsVm.CurrentExecutingTab.StopQueryCommand}"/>
				</Grid>

				<!-- Transaction. Autocommit is the quiet state; an open transaction is the one that is
				     dangerous to forget, so it is the only one that will be highlighted (WS-26, stage 6). -->
				<Border Grid.Column="3"
				        Margin="12,4"
				        Padding="8,1"
				        CornerRadius="3"
				        VerticalAlignment="Center"
				        IsVisible="{Binding MainWindowVm.IsConnected}"
				        Background="{Binding WorkspaceTabsVm.SelectedQueryTab.HasOpenTransaction,
				                     Converter={x:Static converters:PanelConverters.TransactionBrush}}">
					<!-- The fallback is the catalogue's word too: with no query tab selected this was
					     the one English caption left on a Russian window. It cannot be a
					     FallbackValue - a DynamicResource there is assigned as the markup extension
					     OBJECT and the status bar reads its type name. -->
					<TextBlock AutomationProperties.AutomationId="StatusTransaction"
					           FontSize="{DynamicResource Wit.Font.Body}"
					           VerticalAlignment="Center">
						<TextBlock.Text>
							<MultiBinding Converter="{x:Static converters:LocalizedText.Or}"
							              ConverterParameter="Query.Autocommit">
								<DynamicResource ResourceKey="S.$language"/>
								<Binding Path="WorkspaceTabsVm.SelectedQueryTab.TransactionState"/>
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
				</Border>

				<!-- Where the cursor is -->
				<TextBlock Grid.Column="4"
				           AutomationProperties.AutomationId="StatusCaret"
				           Text="{Binding MainWindowVm.CaretSummary}"
				           FontSize="{DynamicResource Wit.Font.Body}"
				           Opacity="0.65"
				           VerticalAlignment="Center"
				           IsVisible="{Binding WorkspaceTabsVm.IsQueryTabSelected}"/>
			</Grid>
		</Border>

		<!-- The command palette (WS-9), over everything. -->
		<Border Grid.Row="0" Grid.RowSpan="4"
		        IsVisible="{Binding PaletteVm.IsOpen}"
		        Background="{DynamicResource Wit.Scrim}">
			<Border Width="560"
			        VerticalAlignment="Top"
			        Margin="0,80,0,0"
			        CornerRadius="9"
			        Background="{DynamicResource Wit.Surface.Bar}"
			        BorderBrush="{DynamicResource Wit.Line}"
			        BorderThickness="1"
			        Padding="8">
				<StackPanel Spacing="6">
					<TextBox AutomationProperties.AutomationId="PaletteQuery"
					         AutomationProperties.Name="{DynamicResource S.Shell.Palette.Query}"
					         x:Name="PaletteQueryBox"
					         Text="{Binding PaletteVm.Query, Mode=TwoWay}"
					         Watermark="{DynamicResource S.Shell.Palette}"
					         BorderThickness="0"/>

					<ListBox AutomationProperties.AutomationId="PaletteItems"
					         ItemsSource="{Binding PaletteVm.Items}"
					         SelectedItem="{Binding PaletteVm.SelectedItem, Mode=TwoWay}"
					         MaxHeight="320"
					         Background="Transparent"
					         BorderThickness="0">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:PaletteItem">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource Wit.Font.BlockTitle}"/>
									<TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="{DynamicResource Wit.Font.Control}"
									           Opacity="0.55" Margin="12,0,0,0"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</Border>
		</Border>

		<!-- The notification list (WS-7): what happened, when nobody had to be asked anything. -->
		<Border Grid.Row="0" Grid.RowSpan="4"
		        IsVisible="{Binding MainWindowVm.AreNotificationsVisible}"
		        Background="Transparent">
			<Border Width="420"
			        MaxHeight="360"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Top"
			        Margin="0,38,8,0"
			        CornerRadius="9"
			        Background="{DynamicResource Wit.Surface.Bar}"
			        BorderBrush="{DynamicResource Wit.Line}"
			        BorderThickness="1"
			        Padding="8">
				<Grid RowDefinitions="Auto,*,Auto">
					<TextBlock Grid.Row="0" Text="{DynamicResource S.Shell.Notifications}" FontWeight="SemiBold" FontSize="{DynamicResource Wit.Font.Body}"
					           Margin="4,2,0,6"/>

					<ScrollViewer Grid.Row="1">
						<ItemsControl AutomationProperties.AutomationId="NotificationList"
						              ItemsSource="{Binding MainWindowVm.Notifications}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="services:Notification">
									<Border Padding="6,4" Margin="0,0,0,4"
									        Background="{DynamicResource Wit.Surface.Sunken}"
									        CornerRadius="5">
										<StackPanel Spacing="2">
											<TextBlock Text="{Binding Title}" FontSize="{DynamicResource Wit.Font.Body}"/>
											<TextBlock Text="{Binding Detail}" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.6"
											           TextWrapping="Wrap"
											           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<TextBlock Grid.Row="1" Text="{DynamicResource S.Shell.NothingYet}"
					           FontSize="{DynamicResource Wit.Font.Body}" Opacity="0.5" Margin="4,8"
					           IsVisible="{Binding !MainWindowVm.HasNotifications}"/>

					<Button AutomationProperties.AutomationId="NotificationsClose"
					        AutomationProperties.Name="{DynamicResource S.Shell.CloseNotifications}"
					        Grid.Row="2" Content="{DynamicResource S.Common.Close}" HorizontalAlignment="Right"
					        Margin="0,6,0,0"
					        Command="{Binding MainWindowVm.HideNotificationsCommand}"/>
				</Grid>
			</Border>
		</Border>

	</Grid>

</Window>
