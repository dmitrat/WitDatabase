<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OutWit.Database.Studio.ViewModels"
             xmlns:models="using:OutWit.Database.Studio.Models"
             xmlns:converters="using:OutWit.Database.Studio.Converters"
             xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="OutWit.Database.Studio.Views.DatabaseExplorer"
             x:DataType="vm:ApplicationViewModel">

    <UserControl.Resources>
        <converters:NodeTypeToIconConverter x:Key="NodeTypeToIconConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}" 
                BorderThickness="0,0,0,1" 
                Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                           Text="{DynamicResource S.Explorer.Title}" 
                           FontWeight="SemiBold" 
                           FontSize="{DynamicResource Wit.Font.SectionTitle}"
                           VerticalAlignment="Center"/>
                
                <Button AutomationProperties.AutomationId="DatabaseExplorerRefresh" AutomationProperties.Name="{DynamicResource S.Common.Refresh}" Grid.Column="1"
                        Command="{Binding DatabaseExplorerVm.RefreshCommand}"
                        ToolTip.Tip="{DynamicResource S.Common.Refresh}"
                        Width="32"
                        Height="{DynamicResource Wit.Height.Button}"
                        Padding="0"
                        VerticalAlignment="Center">
                    <PathIcon Data="{x:Static ui:StudioIcons.MENU_REFRESH}"
                              Width="{DynamicResource Wit.Icon.Header}"
                              Height="{DynamicResource Wit.Icon.Header}" />
                </Button>
            </Grid>
        </Border>

        <!-- Filter (WS-17). It narrows the tree and stays until it is cleared; the palette is the
             other tool - one jump, and gone. -->
        <Border Grid.Row="1"
                Padding="8,6"
                IsVisible="{Binding MainWindowVm.IsConnected}"
                Background="{DynamicResource Wit.Surface.Panel}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox AutomationProperties.AutomationId="ExplorerFilter"
                         AutomationProperties.Name="{DynamicResource S.Explorer.Filter}"
                         Grid.Column="0"
                         Text="{Binding DatabaseExplorerVm.Filter, Mode=TwoWay}"
                         Watermark="{DynamicResource S.Explorer.Filter}"
                         Height="{DynamicResource Wit.Height.Field}"/>
                <Button AutomationProperties.AutomationId="ExplorerClearFilter"
                        AutomationProperties.Name="{DynamicResource S.Explorer.ClearFilter}"
                        Grid.Column="1"
                        Content="Esc"
                        Height="{DynamicResource Wit.Height.ButtonCompact}"
                        Padding="6,0"
                        Margin="4,0,0,0"
                        Command="{Binding DatabaseExplorerVm.ClearFilterCommand}"
                        IsVisible="{Binding DatabaseExplorerVm.IsFiltering}"/>
            </Grid>
        </Border>

        <!-- Filter results: matches from every open connection, each with the path to it -->
        <Grid Grid.Row="2" IsVisible="{Binding DatabaseExplorerVm.IsFiltering}" RowDefinitions="*,Auto">
            <ListBox AutomationProperties.AutomationId="ExplorerFilterMatches"
                     Grid.Row="0"
                     ItemsSource="{Binding DatabaseExplorerVm.FilterMatches}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FilterMatch">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Node.Name}" FontSize="{DynamicResource Wit.Font.Body}"/>
                            <TextBlock Text="{Binding Path}" FontSize="{DynamicResource Wit.Font.Caption}" Opacity="0.55"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1"
                       AutomationProperties.AutomationId="ExplorerFilterSummary"
                       Text="{Binding DatabaseExplorerVm.FilterSummary}"
                       FontSize="{DynamicResource Wit.Font.Control}"
                       Opacity="0.6"
                       Margin="8,4"/>
        </Grid>

        <!-- TreeView -->
        <Border Grid.Row="2"
                IsVisible="{Binding !DatabaseExplorerVm.IsFiltering}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TreeView ItemsSource="{Binding DatabaseExplorerVm.Nodes}"
                          SelectedItem="{Binding DatabaseExplorerVm.SelectedNode}"
                          Background="Transparent">
                    
                    <!-- Bind IsExpanded to node property via DataContext -->
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="models:DatabaseNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:DatabaseNode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{Binding NodeType, Converter={StaticResource NodeTypeToIconConverter}}"
                                         Width="{DynamicResource Wit.Icon.Header}"
                                         Height="{DynamicResource Wit.Icon.Header}"/>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsRenaming}"
                                           FontWeight="{Binding IsRequired, Converter={x:Static converters:NodeConverters.RequiredToWeight}}"/>

                                <!-- F2: the name is edited where it is, and Enter or Escape closes it -->
                                <TextBox AutomationProperties.AutomationId="DatabaseExplorerRenameBox"
                                         Text="{Binding RenameText}"
                                         IsVisible="{Binding IsRenaming}"
                                         MinWidth="140"
                                         Padding="2"
                                         KeyDown="RenameBox_KeyDown"
                                         AttachedToVisualTree="RenameBox_Attached"
                                         VerticalAlignment="Center"/>
                                <!-- The right-hand side of the row: a column's type, a folder's
                                     count, a table's row count once it arrives (2.1, WS-16). -->
                                <TextBlock Text="{Binding Detail}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Wit.Font.Control}"
                                           Opacity="0.55"/>
                                <TextBlock Text="{DynamicResource S.Explorer.Counting}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Wit.Font.Control}"
                                           Opacity="0.4"
                                           IsVisible="{Binding CountState, Converter={x:Static converters:NodeConverters.IsCounting}}"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <!-- The storage tab, on the connection's own node and nowhere else (WS-54) -->
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerOpenDatabaseTab"
                                      Header="{DynamicResource S.Explorer.Menu.Database}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsDatabaseActions}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanOpenDatabaseTab}"
                                      Command="{Binding DatabaseExplorerVm.OpenDatabaseTabCommand}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.DB_DATABASE}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- A database could be closed from File and from nowhere near the tree
                                 it is drawn in. Selecting a node makes its connection the active
                                 one, which is the connection this closes. -->
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerCloseConnection"
                                      Header="{DynamicResource S.Menu.CloseDatabase}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsDatabaseActions}"
                                      Command="{Binding MainWindowVm.CloseDatabaseCommand}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.MENU_CLOSE_DATABASE}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <!-- Create actions -->
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerCreate" Header="{DynamicResource S.Explorer.Menu.Create}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsCreate}">
                                <MenuItem AutomationProperties.AutomationId="DatabaseExplorerCreateTable" Header="{DynamicResource S.Explorer.Menu.CreateTable}"
                                          Command="{Binding DatabaseExplorerVm.CreateTableCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.DB_TABLE}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                
                                <MenuItem AutomationProperties.AutomationId="DatabaseExplorerCreateView" Header="{DynamicResource S.Explorer.Menu.CreateView}"
                                          Command="{Binding DatabaseExplorerVm.CreateViewCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.DB_VIEW}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                
                                <MenuItem AutomationProperties.AutomationId="DatabaseExplorerCreateIndex" Header="{DynamicResource S.Explorer.Menu.CreateIndex}"
                                          Command="{Binding DatabaseExplorerVm.CreateIndexCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.DB_INDEX}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- The dialog has existed since stage 8 and was reachable from the
                                     Structure tab alone, so the screenshot pass reported that Studio
                                     creates no triggers. A trigger names its table, which is why this
                                     one is greyed everywhere but on a table. -->
                                <MenuItem AutomationProperties.AutomationId="DatabaseExplorerCreateTrigger" Header="{DynamicResource S.Explorer.Menu.CreateTrigger}"
                                          IsEnabled="{Binding DatabaseExplorerVm.CanCreateTrigger}"
                                          Command="{Binding DatabaseExplorerVm.CreateTriggerCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static ui:StudioIcons.DB_TRIGGER}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            
                            <Separator/>
                            
                            <!-- Select data submenu -->
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerSelectData" Header="{DynamicResource S.Explorer.Menu.SelectData}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsBrowseData}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanBrowseData}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.DB_TABLE}"/>
                                </MenuItem.Icon>
                                <MenuItem AutomationProperties.AutomationId="DatabaseExplorerSelectTop100" Header="{DynamicResource S.Explorer.Menu.SelectTop100}"
                                          Command="{Binding DatabaseExplorerVm.SelectTop100Command}"/>
                                <MenuItem AutomationProperties.AutomationId="DatabaseExplorerSelectTop1000" Header="{DynamicResource S.Explorer.Menu.SelectTop1000}"
                                          Command="{Binding DatabaseExplorerVm.SelectTop1000Command}"/>
                            </MenuItem>
                            
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerEditData" Header="{DynamicResource S.Explorer.Menu.EditData}"
                                      Command="{Binding DatabaseExplorerVm.EditDataCommand}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsEditData}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanEditData}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.TAB_TABLE_EDIT}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerViewStructure" Header="{DynamicResource S.Explorer.Menu.ViewStructure}"
                                      Command="{Binding DatabaseExplorerVm.ViewStructureCommand}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsViewStructure}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanViewStructure}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.TAB_STRUCTURE}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerViewDefinition" Header="{DynamicResource S.Explorer.Menu.ViewDefinition}"
                                      Command="{Binding DatabaseExplorerVm.ViewDefinitionCommand}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsViewDefinition}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanViewDefinition}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.DB_VIEW}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            
                            <Separator/>
                            
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerRefresh2" Header="{DynamicResource S.Common.Refresh}"
                                      Command="{Binding DatabaseExplorerVm.RefreshCommand}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.MENU_REFRESH}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            
                            <Separator/>

                            <!-- Deferred here from stage 5. Rename is offered for a table only: there
                                 is no ALTER VIEW, ALTER INDEX or ALTER TRIGGER in this language. -->
                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerRename" Header="{DynamicResource S.Explorer.Menu.Rename}"
                                      Command="{Binding DatabaseExplorerVm.BeginRenameCommand}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsRename}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanRename}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.TAB_STRUCTURE}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerTruncate" Header="{DynamicResource S.Explorer.Menu.Truncate}"
                                      Command="{Binding DatabaseExplorerVm.TruncateTableCommand}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsTruncate}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanTruncate}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.COMMON_DELETE}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <MenuItem AutomationProperties.AutomationId="DatabaseExplorerDrop" Header="{DynamicResource S.Explorer.Menu.Drop}"
                                      Command="{Binding DatabaseExplorerVm.DropObjectCommand}"
                                      IsVisible="{Binding DatabaseExplorerVm.ShowsDrop}"
                                      IsEnabled="{Binding DatabaseExplorerVm.CanDropObject}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{x:Static ui:StudioIcons.COMMON_DELETE}" 
                                             Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </ScrollViewer>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="2"
                Background="{DynamicResource Wit.Scrim}"
                IsVisible="{Binding DatabaseExplorerVm.IsLoading}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Border Width="32" Height="32"
                        Background="White"
                        CornerRadius="16">
                    <TextBlock Text="..."
                               FontSize="{DynamicResource Wit.Font.WindowTitle}"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource S.Explorer.Loading}"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Error message -->
        <Border Grid.Row="2"
                Background="{DynamicResource Wit.Warn.Surface}"
                BorderBrush="{DynamicResource Wit.Warn.Border}"
                BorderThickness="1"
                Padding="8"
                Margin="8"
                VerticalAlignment="Top"
                IsVisible="{Binding DatabaseExplorerVm.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource S.Common.ErrorHeading}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Wit.Warn.Text}"/>
                <TextBlock Text="{Binding DatabaseExplorerVm.ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Wit.Warn.Text}"/>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <Grid Grid.Row="2"
              IsVisible="{Binding !MainWindowVm.IsConnected}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Border Width="48" Height="48"
                        Background="{DynamicResource Wit.Surface.Panel}"
                        CornerRadius="24"
                        HorizontalAlignment="Center">
                    <PathIcon Data="{x:Static ui:StudioIcons.DB_DATABASE}"
                              Width="{DynamicResource Wit.Icon.Large}" Height="{DynamicResource Wit.Icon.Large}"
                              Foreground="Gray"/>
                </Border>
                <TextBlock Text="{DynamicResource S.Explorer.NotConnected}"
                           FontSize="{DynamicResource Wit.Font.SectionTitle}"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
