<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
        x:Class="OutWit.Database.Studio.Views.Dialogs.DatabaseCopyDialog"
        x:DataType="vm:DatabaseCopyViewModel"
        Title="{DynamicResource S.Copy.Title}"
        Width="640" Height="480"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,0,0,1"
                Padding="16">
            <StackPanel Spacing="4">
                <TextBlock Name="CopyHeading"
                           AutomationProperties.AutomationId="CopyHeading"
                           Text="{Binding Heading}" FontSize="{DynamicResource Wit.Font.WindowTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource S.Copy.NotADump}"
                           FontSize="{DynamicResource Wit.Font.Body}" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="14">

                <!-- FIRST, not last. The same mistake the rebuild dialog made and had fixed: the one
                     thing the dialog exists to say ended up below the fold, and the copy looked as if
                     it had done nothing. -->
                <Border IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        BorderBrush="{DynamicResource Wit.Line}"
                        BorderThickness="1" CornerRadius="4" Padding="12">
                    <TextBlock Name="CopyMessage"
                               AutomationProperties.AutomationId="CopyMessage"
                               Text="{Binding Message}" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource S.Copy.Source}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Parts}" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource S.Copy.PartsNote}"
                               FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource S.Copy.Destination}" FontWeight="SemiBold"/>
                    <TextBox Name="CopyDestination"
                             AutomationProperties.AutomationId="CopyDestination"
                             AutomationProperties.Name="{DynamicResource S.Copy.Destination}"
                             Text="{Binding Destination}"/>
                </StackPanel>

                <CheckBox Name="CopyVerify"
                          AutomationProperties.AutomationId="CopyVerify"
                          IsChecked="{Binding Verify}"
                          Content="{DynamicResource S.Copy.Verify}"/>

                <!-- Said BEFORE anything happens: a paged database cannot be read while the engine
                     holds it, so taking the bytes means letting go of it first. -->
                <Border IsVisible="{Binding WillCloseTheConnection}"
                        Background="{DynamicResource Wit.Surface.Panel}"
                        Padding="12" CornerRadius="4">
                    <TextBlock Name="CopyWillClose"
                               AutomationProperties.AutomationId="CopyWillClose"
                               Text="{DynamicResource S.Copy.WillClose}" TextWrapping="Wrap"/>
                </Border>

                <Border IsVisible="{Binding HasOpenTransaction}"
                        Background="{DynamicResource Wit.Warn.Surface}"
                        Padding="12" CornerRadius="4">
                    <TextBlock Name="CopyTransactionWarning"
                               AutomationProperties.AutomationId="CopyTransactionWarning"
                               Text="{DynamicResource S.Copy.TransactionOpen}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{DynamicResource S.Copy.NoRestore}"
                           FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Name="CopyRunButton"
                        AutomationProperties.AutomationId="CopyRun"
                        Command="{Binding CopyCommand}"
                        Content="{DynamicResource S.Copy.Run}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Name="CopyOpenButton"
                            AutomationProperties.AutomationId="CopyOpen"
                            Command="{Binding OpenCopyCommand}"
                            IsVisible="{Binding IsDone}"
                            Content="{DynamicResource S.Copy.OpenCopy}"/>

                    <Button Name="CopyCloseButton"
                            AutomationProperties.AutomationId="CopyClose"
                            Command="{Binding CloseCommand}"
                            Content="{DynamicResource S.Common.Close}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
