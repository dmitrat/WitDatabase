<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        xmlns:models="using:OutWit.Database.Studio.Models"
        xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
        mc:Ignorable="d"
        d:DesignWidth="700"
        d:DesignHeight="650"
        x:Class="OutWit.Database.Studio.Views.Dialogs.ImportDialog"
        x:DataType="vm:ImportViewModel"
        Title="{DynamicResource S.Dialog.Import.Title}"
        Width="700"
        Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="600"
        MinHeight="550">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="20">

        <!-- The only wizard in the product, and it has three steps because the decisions depend on
             each other: how the file was read, where the rows go, how the columns line up (6.4). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource S.Dialog.Import.Step.File}" FontWeight="SemiBold"
                       Opacity="{Binding Step, Converter={x:Static vm:ImportSteps.OpacityForFile}}"/>
            <TextBlock Text="{DynamicResource S.Dialog.Import.Step.Destination}" FontWeight="SemiBold"
                       Opacity="{Binding Step, Converter={x:Static vm:ImportSteps.OpacityForDestination}}"/>
            <TextBlock Text="{DynamicResource S.Dialog.Import.Step.Columns}" FontWeight="SemiBold"
                       Opacity="{Binding Step, Converter={x:Static vm:ImportSteps.OpacityForColumns}}"/>
        </StackPanel>

        <!-- Source File -->
        <StackPanel Grid.Row="1" Spacing="8"
                    IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsFile}}">
            <TextBlock Text="{DynamicResource S.Dialog.Import.SourceFile}" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ComboBox Grid.Column="0"
                          Width="100"
                          Margin="0,0,8,0"
                          SelectedIndex="{Binding SelectedFormat}"
                          IsEnabled="{Binding !IsImporting}">
                    <ComboBoxItem Content="CSV"/>
                    <ComboBoxItem Content="JSON"/>
                </ComboBox>
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath}"
                         Watermark="{DynamicResource S.Dialog.Import.SelectFile}"
                         IsReadOnly="True"/>
                <Button AutomationProperties.AutomationId="ImportBrowse" Grid.Column="2"
                        Content="{DynamicResource S.Common.Browse}"
                        Command="{Binding BrowseCommand}"
                        IsEnabled="{Binding !IsImporting}"
                        Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- STEP 1: how the file was read. Detected, and still visible and editable. -->
        <StackPanel Grid.Row="2"
                    Spacing="8"
                    Margin="0,16,0,0"
                    IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsFile}}">
            <TextBlock Text="{DynamicResource S.Dialog.Import.CsvOptions}" FontWeight="SemiBold"
                       IsVisible="{Binding SelectedFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ImportFormat.Csv}}"/>
            <StackPanel Orientation="Horizontal" Spacing="16"
                        IsVisible="{Binding SelectedFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ImportFormat.Csv}}">
                <CheckBox Content="{DynamicResource S.Dialog.Import.HasHeaders}"
                          IsChecked="{Binding HasHeaders}"
                          IsEnabled="{Binding !IsImporting}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource S.Dialog.Import.Delimiter}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Delimiter}"
                             Width="50"
                             IsEnabled="{Binding !IsImporting}"/>
                </StackPanel>
            </StackPanel>

            <!-- A CSV cannot tell an empty string from a missing value, so the user says which, once. -->
            <CheckBox AutomationProperties.AutomationId="ImportEmptyIsNull"
                      AutomationProperties.Name="{DynamicResource S.Dialog.Import.EmptyIsNull.Name}"
                      IsChecked="{Binding EmptyIsNull}"
                      IsEnabled="{Binding !IsImporting}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource S.Dialog.Import.EmptyIsNull}"/>
                    <TextBlock Text="{DynamicResource S.Dialog.Import.EmptyIsNull.Hint}"
                               Foreground="{DynamicResource Wit.Ink.Secondary}"
                               FontSize="12"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>

        <!-- STEP 3: what to do when an imported row collides with one that is already there. -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,16,0,0"
                    IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsColumns}}">
            <TextBlock Text="{DynamicResource S.Dialog.Import.OnConflict}" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton AutomationProperties.AutomationId="ImportConflictSkip"
                             GroupName="Conflict" Content="{DynamicResource S.Dialog.Import.Conflict.Skip}"
                             IsChecked="{Binding OnConflict, Converter={x:Static vm:ImportSteps.ConflictIsSkip}}"
                             Command="{Binding ChooseConflictCommand}" CommandParameter="Skip"/>
                <RadioButton AutomationProperties.AutomationId="ImportConflictUpdate"
                             GroupName="Conflict" Content="{DynamicResource S.Dialog.Import.Conflict.Update}"
                             IsChecked="{Binding OnConflict, Converter={x:Static vm:ImportSteps.ConflictIsUpdate}}"
                             Command="{Binding ChooseConflictCommand}" CommandParameter="Update"/>
                <RadioButton AutomationProperties.AutomationId="ImportConflictAbort"
                             GroupName="Conflict" Content="{DynamicResource S.Dialog.Import.Conflict.Abort}"
                             IsChecked="{Binding OnConflict, Converter={x:Static vm:ImportSteps.ConflictIsAbort}}"
                             Command="{Binding ChooseConflictCommand}" CommandParameter="Abort"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding OnConflict, Converter={x:Static vm:ImportSteps.ConflictIsUpdate}}">
                <TextBlock Text="{DynamicResource S.Dialog.Import.KeyColumn}" VerticalAlignment="Center"/>
                <ComboBox AutomationProperties.AutomationId="ImportKeyColumn"
                          ItemsSource="{Binding AvailableTargetColumns}"
                          SelectedItem="{Binding KeyColumn}"
                          Width="180"
                          PlaceholderText="{DynamicResource S.Dialog.Import.KeyColumnHint}"/>
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Wit.Ink.Secondary}"
                           Text="{DynamicResource S.Dialog.Import.MergeNote}"/>
            </StackPanel>

            <!-- Off by default: a million rows in one transaction is a million versions in MVCC and a
                 journal that grows until it stops. The default must not be the mode that fails on the
                 largest file (6.4). -->
            <CheckBox AutomationProperties.AutomationId="ImportAllOrNothing"
                      AutomationProperties.Name="{DynamicResource S.Dialog.Import.AllOrNothing.Name}"
                      IsChecked="{Binding AllOrNothing}"
                      IsEnabled="{Binding !IsImporting}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource S.Dialog.Import.AllOrNothing}"/>
                    <TextBlock Text="{DynamicResource S.Dialog.Import.AllOrNothing.Hint}"
                               Foreground="{DynamicResource Wit.Ink.Secondary}"
                               FontSize="12"/>
                </StackPanel>
            </CheckBox>

            <CheckBox AutomationProperties.AutomationId="ImportStopOnError"
                      Content="{DynamicResource S.Dialog.Import.StopOnError}"
                      IsChecked="{Binding StopOnError}"
                      IsEnabled="{Binding !IsImporting}"/>
        </StackPanel>

        <!-- Target and Mapping -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="0,16,0,0"
              IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsNotFile}}">

            <!-- Target Table -->
            <StackPanel Grid.Row="0" Spacing="8"
                        IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsDestination}}">
                <TextBlock Text="{DynamicResource S.Dialog.Import.TargetTable}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableTables}"
                          SelectedItem="{Binding SelectedTable}"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !IsImporting}"
                          PlaceholderText="{DynamicResource S.Dialog.Import.SelectTarget}"/>
            </StackPanel>

            <!-- Column Mapping -->
            <!-- The mapping belongs to step 3 and only to step 3. It was bound to "not the first step"
                 and appeared on step 2 as well, empty - which reads as a step with nothing in it.
                 Found by driving the application. -->
            <Grid Grid.Row="1" Margin="0,16,0,0" RowDefinitions="Auto,*"
                  IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsColumns}}">
                <TextBlock Grid.Row="0" Text="{DynamicResource S.Dialog.Import.Mapping}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource Wit.Line}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DataGrid ItemsSource="{Binding ColumnMappings}"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              IsEnabled="{Binding !IsImporting}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{DynamicResource S.Dialog.Import.Include}" 
                                                    Binding="{Binding IsIncluded}"
                                                    Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource S.Dialog.Import.SourceColumn}" 
                                                Binding="{Binding SourceColumn}"
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="{DynamicResource S.Dialog.Import.TargetColumn}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ColumnMapping">
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:ImportViewModel)DataContext).AvailableTargetColumns}"
                                                  SelectedItem="{Binding TargetColumn}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            
        </Grid>

        <!-- Preview Info -->
        <Border Grid.Row="5"
                Background="{DynamicResource Wit.Ok.Surface}"
                BorderBrush="{DynamicResource Wit.Ok.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,16,0,0"
                IsVisible="{Binding PreviewData, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- One string each, not five Runs. A sentence assembled out of fragments cannot be
                 translated: another language moves the pieces, and the count is a plural. -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock AutomationProperties.AutomationId="ImportPreviewRows"
                           Text="{Binding PreviewRowsSummary}" Foreground="{DynamicResource Wit.Ok.Text}"/>
                <TextBlock AutomationProperties.AutomationId="ImportPreviewColumns"
                           Text="{Binding PreviewColumnsSummary}" Foreground="{DynamicResource Wit.Ok.Text}"/>
            </StackPanel>
        </Border>

        <!-- Error Message -->
        <Border Grid.Row="5"
                Background="{DynamicResource Wit.Error.Surface}"
                BorderBrush="{DynamicResource Wit.Error.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,16,0,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                              Width="16" Height="16"
                              Foreground="{DynamicResource Wit.Error.Text}"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Wit.Error.Text}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- Error Details -->
                <ItemsControl ItemsSource="{Binding ImportErrors}"
                              IsVisible="{Binding ImportErrors.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource Wit.Error.Text}"
                                       FontSize="11"
                                       Margin="24,2,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,20,0,0">
            <Button AutomationProperties.AutomationId="ImportRefreshPreview" Grid.Column="0"
                    Content="{DynamicResource S.Dialog.Import.RefreshPreview}"
                    Command="{Binding PreviewCommand}"
                    IsEnabled="{Binding CanPreview}"/>

            <!-- The rejected rows, all of them - the window shows ten. An import that reports
                 "16 skipped" and can name three is an import nobody can fix. -->
            <Button AutomationProperties.AutomationId="ImportWriteReport" Grid.Column="1"
                    Content="{DynamicResource S.Dialog.Import.Report}"
                    Margin="8,0,0,0"
                    Command="{Binding WriteReportCommand}"
                    IsVisible="{Binding Rejected.Count}"/>

            <Button AutomationProperties.AutomationId="ImportBack" Grid.Column="3"
                    Content="{DynamicResource S.Common.Back}"
                    Command="{Binding BackCommand}"
                    Width="80"
                    Margin="0,0,8,0"
                    IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsNotFile}}"/>

            <Button AutomationProperties.AutomationId="ImportCancel" Grid.Column="4"
                    Content="{DynamicResource S.Common.Cancel}"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Margin="0,0,8,0"
                    IsVisible="{Binding !IsImporting}"/>

            <Button AutomationProperties.AutomationId="ImportNext" Grid.Column="5"
                    Content="{DynamicResource S.Common.Next}"
                    Command="{Binding NextCommand}"
                    Width="90"
                    Classes="accent"
                    IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsNotColumns}}"/>

            <!-- The verb, and only on the last step (6.1). -->
            <Button AutomationProperties.AutomationId="ImportImport" Grid.Column="5"
                    Content="{DynamicResource S.Dialog.Import.Import}"
                    Command="{Binding ImportCommand}"
                    IsEnabled="{Binding CanImport}"
                    Width="90"
                    Classes="accent"
                    IsVisible="{Binding Step, Converter={x:Static vm:ImportSteps.IsColumns}}"/>
        </Grid>
        
        <!-- Loading Overlay with Progress -->
        <Border Grid.Row="0"
                Grid.RowSpan="7"
                Background="{DynamicResource Wit.Scrim}"
                IsVisible="{Binding IsImporting}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Width="350">
                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ImportProgress}"
                             Minimum="0"
                             Maximum="100"
                             Height="8"/>
                
                <!-- Progress Text -->
                <TextBlock AutomationProperties.AutomationId="ImportProgressText"
                           Text="{Binding ProgressText}"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="16"/>

                <!-- Failed count (if any) -->
                <TextBlock AutomationProperties.AutomationId="ImportFailedText"
                           Text="{Binding FailedText}"
                           Foreground="{DynamicResource Wit.Error.Text}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           IsVisible="{Binding RowsFailed}"/>

                <!-- Percentage -->
                <TextBlock Text="{Binding ImportProgress, StringFormat='{}{0:F1} %'}"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Opacity="0.8"/>
                
                <!-- Cancel Button -->
                <Button AutomationProperties.AutomationId="ImportCancelImport" Content="{DynamicResource S.Dialog.Import.CancelImport}"
                        Command="{Binding CancelImportCommand}"
                        HorizontalAlignment="Center"
                        Width="120"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        
    </Grid>

</Window>