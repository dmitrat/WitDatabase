<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        xmlns:conv="using:OutWit.Database.Studio.Converters"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="470"
        x:Class="OutWit.Database.Studio.Views.Dialogs.OpenDatabaseDialog"
        x:DataType="vm:ConnectionViewModel"
        Title="{DynamicResource S.Dialog.Open.Title}"
        Width="520"
        Height="470"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!-- The rules of 6.1: fixed size, the error inside the window rather than a modal on a modal, the
         helper on the left and the one accented verb on the right. Nothing here asks what the FILE
         already knows - since 12.2.0 it records its store, journal, MVCC and page size (WS-46). -->
    <Grid RowDefinitions="*,Auto,Auto" Margin="0">

        <ScrollViewer Grid.Row="0" Padding="18,16">
            <StackPanel Spacing="10">

                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{DynamicResource S.Dialog.Open.Path}" Margin="0,6,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBox AutomationProperties.AutomationId="OpenDatabasePath"
                                 Text="{Binding ConnectionInfo.FilePath, Mode=TwoWay}"
                                 Watermark="{DynamicResource S.Dialog.Open.PathExample}"/>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Button AutomationProperties.AutomationId="OpenDatabaseFile"
                                    Content="{DynamicResource S.Common.File}"
                                    Command="{Binding BrowseFileCommand}"/>
                            <Button AutomationProperties.AutomationId="OpenDatabaseFolder"
                                    Content="{DynamicResource S.Common.Folder}"
                                    Command="{Binding BrowseFolderCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Dialog.Open.PathHint}"
                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- What was found, in whichever of the three states the engine allows. An encrypted
                     database says only that it is encrypted, because its header is inside the
                     encryption; a file with no magic bytes says "encrypted, or not a database", because
                     those two cannot be told apart at all. -->
                <!-- Two lines rather than one: what is at the path, and - separately - whether the path
                     is one this application already has open. The second is a question Studio can
                     always answer, so it is not one of the readings the probe returns. -->
                <Border Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        IsVisible="{Binding HasProbeBanner}">
                    <StackPanel x:Name="ProbeBanner" Spacing="4">
                        <TextBlock AutomationProperties.AutomationId="OpenDatabaseProbe"
                                   Text="{Binding ProbeMessage}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding ProbeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock AutomationProperties.AutomationId="OpenDatabaseAlreadyOpen"
                                   Text="{Binding AlreadyOpenNote}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding AlreadyOpenNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <!-- Asked for only when there is something encrypted to open (WS-46). -->
                <Grid ColumnDefinitions="110,*" IsVisible="{Binding NeedsPassword}">
                    <TextBlock Grid.Column="0" Text="{DynamicResource S.Dialog.Open.Password}" Margin="0,6,0,0"/>
                    <TextBox Grid.Column="1"
                             AutomationProperties.AutomationId="OpenDatabasePassword"
                             Text="{Binding ConnectionInfo.Password, Mode=TwoWay}"
                             PasswordChar="*" RevealPassword="False"/>
                </Grid>

                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{DynamicResource S.Dialog.Open.NameAndLabel}" Margin="0,6,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox AutomationProperties.AutomationId="OpenDatabaseName"
                                     Text="{Binding ConnectionInfo.DisplayName, Mode=TwoWay}"
                                     Width="180"/>

                            <!-- The palette is the one in ConnectionColors, which is also what draws
                                 the stripe on the tab. A picker whose colour appeared nowhere would be
                                 decoration. -->
                            <ListBox AutomationProperties.AutomationId="OpenDatabaseColour"
                                     SelectedIndex="{Binding ConnectionInfo.ColorIndex, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalAlignment="Center">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBoxItem AutomationProperties.Name="{DynamicResource S.Color.Green}"><Border Width="18" Height="18" CornerRadius="5" Background="#4CC13C"/></ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="{DynamicResource S.Color.Amber}"><Border Width="18" Height="18" CornerRadius="5" Background="#D9A227"/></ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="{DynamicResource S.Color.Violet}"><Border Width="18" Height="18" CornerRadius="5" Background="#8A7BE8"/></ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="{DynamicResource S.Color.Cyan}"><Border Width="18" Height="18" CornerRadius="5" Background="#35A7C4"/></ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="{DynamicResource S.Color.Red}"><Border Width="18" Height="18" CornerRadius="5" Background="#D9534F"/></ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="{DynamicResource S.Color.Grey}"><Border Width="18" Height="18" CornerRadius="5" Background="#5D6879"/></ListBoxItem>
                            </ListBox>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Dialog.Open.ColourHint}"
                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="{DynamicResource S.Dialog.Open.ReadOnly}"
                          IsChecked="{Binding ConnectionInfo.IsReadOnly}"/>

                <!-- WS-49: what will actually reach WitDbConnection, editable. The provider has a
                     dozen and a half properties this window deliberately does not ask about; not
                     asking is a choice, hiding them is not. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsConnectionStringVisible}">
                    <TextBlock Text="{DynamicResource S.Common.ConnectionString}" FontSize="11" Opacity="0.6"/>
                    <TextBox AutomationProperties.AutomationId="OpenDatabaseConnectionStringBox"
                             Text="{Binding ConnectionString, Mode=TwoWay}"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" AcceptsReturn="False"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- The error is a strip above the buttons, and the last one is gone when the window reopens. -->
        <Border Grid.Row="1" Margin="18,0,18,10" Padding="10,8" CornerRadius="6"
                Background="#22D9534F" BorderBrush="#55D9534F" BorderThickness="1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock AutomationProperties.AutomationId="OpenDatabaseError"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <Border Grid.Row="2" Padding="14,10"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="OpenDatabaseConnectionString"
                        Content="{DynamicResource S.Common.ConnectionString}"
                        Command="{Binding ShowConnectionStringCommand}"/>

                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Opacity="0.6"
                           Text="{DynamicResource S.Dialog.Open.Connecting}"
                           IsVisible="{Binding IsConnecting}"/>

                <Button Grid.Column="2" Margin="0,0,8,0" Width="100"
                        AutomationProperties.AutomationId="OpenDatabaseCancel"
                        Content="{DynamicResource S.Common.Cancel}"
                        Command="{Binding CancelCommand}"/>

                <!-- The verb, not "OK" (6.1). -->
                <Button Grid.Column="3" Width="120" Classes="accent"
                        AutomationProperties.AutomationId="OpenDatabaseOpen"
                        Content="{DynamicResource S.Dialog.Open.Connect}"
                        Command="{Binding ConnectCommand}"/>
            </Grid>
        </Border>
    </Grid>

</Window>
