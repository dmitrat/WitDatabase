<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="OutWit.Database.Studio.Views.Dialogs.OpenDatabaseDialog"
        x:DataType="vm:ConnectionViewModel"
        Title="Open Database"
        Width="600"
        Height="500"
        MinHeight="450"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Open Database"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Open an existing database. Its configuration is read from the database itself."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </StackPanel>

        <!-- Content -->
        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <StackPanel Spacing="16" Margin="8" MaxWidth="560">
                    <!-- Database path. A B+Tree database is a file and an LSM database is a
                         directory, so both pickers are offered - a file picker alone made an LSM
                         database impossible to open. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Database:"
                                   FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ConnectionInfo.FilePath, Mode=TwoWay}"
                                     Watermark="C:\Data\myapp.witdb"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseFileCommand}"
                                    Content="File..."
                                    Width="90"
                                    Margin="0,0,8,0"
                                    ToolTip.Tip="Open a B+Tree database file"/>
                            <Button Grid.Column="2"
                                    Command="{Binding BrowseFolderCommand}"
                                    Content="Folder..."
                                    Width="90"
                                    ToolTip.Tip="Open an LSM database, which is a directory of SSTables"/>
                        </Grid>
                    </StackPanel>

                    <!-- Encryption -->
                    <CheckBox IsChecked="{Binding ConnectionInfo.IsEncrypted}"
                              Content="Database is encrypted"/>

                    <!-- Password -->
                    <StackPanel Spacing="4"
                                IsVisible="{Binding ConnectionInfo.IsEncrypted}">
                        <TextBlock Text="Password:"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ConnectionInfo.Password, Mode=TwoWay}"
                                 Watermark="Enter password"
                                 PasswordChar="*"
                                 RevealPassword="False"/>
                    </StackPanel>

                    <!-- Storage engine, transactions, MVCC and file locking used to be offered here
                         and on an Advanced tab. None of them ever reached the engine:
                         BuildConnectionString emits only Data Source, Mode, Encryption, Password and
                         Store, so clearing "Enable MVCC" got an MVCC database and no message. Since
                         12.2.0 the file records all of them and supplies whatever the connection
                         string does not name, so the honest fix is to stop asking. -->

                    <!-- Read Only -->
                    <CheckBox IsChecked="{Binding ConnectionInfo.IsReadOnly}"
                              Content="Open in read-only mode"/>

                    <!-- Error Message -->
                    <Border Background="#FFF3CD"
                            BorderBrush="#FFC107"
                            BorderThickness="1"
                            Padding="12"
                            CornerRadius="4"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="[!] Error"
                                       FontWeight="Bold"
                                       Foreground="#856404"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="#856404"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Buttons -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,8,0,0">
            <StackPanel Grid.Column="0"
                       Orientation="Horizontal"
                       Spacing="8"
                       IsVisible="{Binding IsConnecting}">
                <Border Width="16" Height="16"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="8">
                    <TextBlock Text="..."
                               FontSize="10"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Connecting..."
                           VerticalAlignment="Center"
                           Foreground="Gray"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="100"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="2"
                    Content="Open"
                    Command="{Binding ConnectCommand}"
                    Width="100"
                    Classes="accent"/>
        </Grid>
    </Grid>

</Window>
