<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="540"
        x:Class="OutWit.Database.Studio.Views.Dialogs.CreateDatabaseDialog"
        x:DataType="vm:ConnectionViewModel"
        Title="{DynamicResource S.Dialog.Create.Title}"
        Width="520"
        Height="540"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!-- The construction follows the physics (WS-48): the STORAGE is chosen first, because it is what
         decides whether the next question is a file, an empty folder, or nothing at all. The three
         defects of 2.0 - LSM creating a second abandoned database, in-memory writing to disk, and
         in-memory connecting elsewhere - were all this question being asked in the wrong order. -->
    <Grid RowDefinitions="*,Auto,Auto">

        <ScrollViewer Grid.Row="0" Padding="18,16">
            <StackPanel Spacing="10">

                <TextBlock Text="{DynamicResource S.Dialog.Create.Storage}" FontSize="10" Opacity="0.55"/>

                <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                    <RadioButton AutomationProperties.AutomationId="CreateStorageBTree"
                                 GroupName="Storage" Margin="0,0,6,0"
                                 IsChecked="{Binding NeedsFile, Mode=OneWay}"
                                 Command="{Binding ChooseStorageCommand}" CommandParameter="btree">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource S.Dialog.Create.BTree}" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Create.BTreeHint}"
                                       FontSize="10.5" Opacity="0.6" TextWrapping="Wrap" MaxWidth="140"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton AutomationProperties.AutomationId="CreateStorageLsm"
                                 GroupName="Storage" Margin="0,0,6,0"
                                 IsChecked="{Binding NeedsFolder, Mode=OneWay}"
                                 Command="{Binding ChooseStorageCommand}" CommandParameter="lsm">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource S.Dialog.Create.Lsm}" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Create.LsmHint}"
                                       FontSize="10.5" Opacity="0.6" TextWrapping="Wrap" MaxWidth="140"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton AutomationProperties.AutomationId="CreateStorageMemory"
                                 GroupName="Storage"
                                 IsChecked="{Binding IsInMemory, Mode=OneWay}"
                                 Command="{Binding ChooseStorageCommand}" CommandParameter="memory">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource S.Dialog.Create.InMemory}" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Create.InMemoryHint}"
                                       FontSize="10.5" Opacity="0.6" TextWrapping="Wrap" MaxWidth="140"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- One field, and WHICH field it is follows the choice above. -->
                <Grid ColumnDefinitions="110,*" IsVisible="{Binding IsFileBased}" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Margin="0,6,0,0"
                               Text="{Binding PathLabel}"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBox AutomationProperties.AutomationId="CreateDatabasePath"
                                 Text="{Binding ConnectionInfo.FilePath, Mode=TwoWay}"/>
                        <Button AutomationProperties.AutomationId="CreateDatabaseBrowse"
                                Content="{DynamicResource S.Common.Browse}"
                                Command="{Binding BrowseFileCommand}"/>
                        <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                   Text="{Binding PathHint}"/>
                    </StackPanel>
                </Grid>

                <!-- The honest warning rather than a lost database. -->
                <Border Padding="10,8" CornerRadius="6" IsVisible="{Binding IsInMemory}"
                        Background="#22D9A227" BorderBrush="#55D9A227" BorderThickness="1">
                    <TextBlock Text="{DynamicResource S.Dialog.Create.InMemoryWarning}"
                               TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <TextBlock Text="{DynamicResource S.Dialog.Create.Encryption}" FontSize="10" Opacity="0.55"
                           Margin="0,8,0,0"/>

                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{DynamicResource S.Dialog.Create.Algorithm}" Margin="0,6,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <RadioButton AutomationProperties.AutomationId="CreateEncryptionNone"
                                     GroupName="Encryption"
                                     Content="{DynamicResource S.Dialog.Create.NoEncryption}"
                                     IsChecked="{Binding IsNotEncrypted, Mode=OneWay}"
                                     Command="{Binding ChooseEncryptionCommand}" CommandParameter=""/>
                        <RadioButton AutomationProperties.AutomationId="CreateEncryptionAes"
                                     GroupName="Encryption" Content="AES-256-GCM"
                                     IsChecked="{Binding IsAesGcm, Mode=OneWay}"
                                     Command="{Binding ChooseEncryptionCommand}" CommandParameter="aes-gcm"/>
                        <RadioButton AutomationProperties.AutomationId="CreateEncryptionChaCha"
                                     GroupName="Encryption" Content="ChaCha20"
                                     IsChecked="{Binding IsChaCha20, Mode=OneWay}"
                                     Command="{Binding ChooseEncryptionCommand}"
                                     CommandParameter="chacha20-poly1305"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="110,*" IsVisible="{Binding ConnectionInfo.IsEncrypted}">
                    <TextBlock Grid.Column="0" Text="{DynamicResource S.Dialog.Create.Password}" Margin="0,6,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBox AutomationProperties.AutomationId="CreateDatabasePassword"
                                 Text="{Binding ConnectionInfo.Password, Mode=TwoWay}"
                                 PasswordChar="*" RevealPassword="False"/>
                        <TextBox AutomationProperties.AutomationId="CreateDatabasePasswordAgain"
                                 Text="{Binding PasswordAgain, Mode=TwoWay}"
                                 Watermark="{DynamicResource S.Dialog.Create.PasswordAgain}"
                                 PasswordChar="*" RevealPassword="False"/>
                        <TextBlock Text="{DynamicResource S.Dialog.Create.PasswordHint}"
                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6" IsVisible="{Binding IsConnectionStringVisible}">
                    <TextBlock Text="{DynamicResource S.Common.ConnectionString}" FontSize="11" Opacity="0.6"/>
                    <TextBox AutomationProperties.AutomationId="CreateConnectionStringBox"
                             Text="{Binding ConnectionString, Mode=TwoWay}"
                             FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="18,0,18,10" Padding="10,8" CornerRadius="6"
                Background="#22D9534F" BorderBrush="#55D9534F" BorderThickness="1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock AutomationProperties.AutomationId="CreateDatabaseError"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <Border Grid.Row="2" Padding="14,10"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="CreateDatabaseConnectionString"
                        Content="{DynamicResource S.Common.ConnectionString}"
                        Command="{Binding ShowConnectionStringCommand}"/>

                <Button Grid.Column="2" Margin="0,0,8,0" Width="100"
                        AutomationProperties.AutomationId="CreateDatabaseCancel"
                        Content="{DynamicResource S.Common.Cancel}"
                        Command="{Binding CancelCommand}"/>

                <Button Grid.Column="3" Width="140" Classes="accent"
                        AutomationProperties.AutomationId="CreateDatabaseCreate"
                        Content="{DynamicResource S.Dialog.Create.Create}"
                        Command="{Binding ConnectCommand}"/>
            </Grid>
        </Border>
    </Grid>

</Window>
