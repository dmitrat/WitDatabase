<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="560"
        x:Class="OutWit.Database.Studio.Views.Dialogs.ChangePasswordDialog"
        x:DataType="vm:ChangePasswordViewModel"
        Title="{DynamicResource S.Password.Title}"
        Width="640" Height="560"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,0,0,1"
                Padding="16">
            <StackPanel Spacing="4">
                <TextBlock Name="PasswordHeading"
                           AutomationProperties.AutomationId="PasswordHeading"
                           Text="{Binding Heading}" FontSize="{DynamicResource Wit.Font.WindowTitle}" FontWeight="SemiBold"/>
                <!--
                    Two different operations behind one window, and the difference is worth the two
                    lines: replacing a password on a database that already has one rewrites 60 bytes,
                    while encrypting one - or taking encryption away - copies the whole database. A
                    person about to press a button on a large database has to know which one it is.
                -->
                <TextBlock Name="PasswordExplainsRewrap"
                           AutomationProperties.AutomationId="PasswordExplainsRewrap"
                           IsVisible="{Binding IsRewrap}"
                           Text="{DynamicResource S.Password.RewrapExplains}"
                           FontSize="{DynamicResource Wit.Font.Body}" Opacity="0.75" TextWrapping="Wrap"/>
                <TextBlock IsVisible="{Binding !IsRewrap}"
                           Text="{DynamicResource S.Password.Explanation}"
                           FontSize="{DynamicResource Wit.Font.Body}" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="14">

                <!-- The report first, for the reason the copy dialog learnt. -->
                <Border IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        BorderBrush="{DynamicResource Wit.Line}"
                        BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Name="PasswordMessage"
                                   AutomationProperties.AutomationId="PasswordMessage"
                                   Text="{Binding Message}" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource S.Password.What}" FontWeight="SemiBold"/>

                    <RadioButton Name="PasswordReplace"
                                 AutomationProperties.AutomationId="PasswordReplace"
                                 GroupName="PasswordChange"
                                 IsVisible="{Binding WasEncrypted}"
                                 IsChecked="{Binding Change, Converter={x:Static vm:PasswordChangeConverter.Instance}, ConverterParameter=Replace, Mode=TwoWay}"
                                 Content="{DynamicResource S.Password.Replace}"/>

                    <RadioButton Name="PasswordEncrypt"
                                 AutomationProperties.AutomationId="PasswordEncrypt"
                                 GroupName="PasswordChange"
                                 IsVisible="{Binding !WasEncrypted}"
                                 IsChecked="{Binding Change, Converter={x:Static vm:PasswordChangeConverter.Instance}, ConverterParameter=Encrypt, Mode=TwoWay}"
                                 Content="{DynamicResource S.Password.Encrypt}"/>

                    <RadioButton Name="PasswordRemove"
                                 AutomationProperties.AutomationId="PasswordRemove"
                                 GroupName="PasswordChange"
                                 IsVisible="{Binding WasEncrypted}"
                                 IsChecked="{Binding Change, Converter={x:Static vm:PasswordChangeConverter.Instance}, ConverterParameter=Remove, Mode=TwoWay}"
                                 Content="{DynamicResource S.Password.Remove}"/>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding NeedsPassword}">
                    <TextBlock Text="{DynamicResource S.Password.New}" FontWeight="SemiBold"/>
                    <TextBox Name="PasswordNew"
                             AutomationProperties.AutomationId="PasswordNew"
                             AutomationProperties.Name="{DynamicResource S.Password.New}"
                             PasswordChar="•"
                             Text="{Binding NewPassword}"/>
                    <TextBox Name="PasswordNewAgain"
                             AutomationProperties.AutomationId="PasswordNewAgain"
                             AutomationProperties.Name="{DynamicResource S.Password.Again}"
                             PasswordChar="•"
                             Text="{Binding NewPasswordAgain}"/>
                    <TextBlock Text="{DynamicResource S.Password.NoCurrent}"
                               FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>

                <!--
                    The warning belongs to the rewrap ALONE, and that is the point of it. The
                    migration's safety is that the original is left where it is; a rewrap changes the
                    only copy there is. Nothing can be lost - the data key does not move, so every
                    page stays readable - but a forgotten new password locks the database as surely
                    as any other, and there is no old one kept anywhere to fall back to.
                -->
                <Border CornerRadius="4" Padding="10"
                        IsVisible="{Binding IsRewrap}"
                        Background="{DynamicResource Wit.Warn.Surface}"
                        BorderBrush="{DynamicResource Wit.Warn.Border}" BorderThickness="1">
                    <TextBlock Name="PasswordRewrapWarning"
                               AutomationProperties.AutomationId="PasswordRewrapWarning"
                               Text="{DynamicResource S.Password.RewrapWarning}"
                               Foreground="{DynamicResource Wit.Warn.Text}" TextWrapping="Wrap"/>
                </Border>

                <!-- A rewrap has no destination: it is the same file, so asking for a name for it
                     would be asking for something that is never used. -->
                <StackPanel Spacing="4" IsVisible="{Binding !IsRewrap}">
                    <TextBlock Text="{DynamicResource S.Password.NewFile}" FontWeight="SemiBold"/>
                    <TextBox Name="PasswordDestination"
                             AutomationProperties.AutomationId="PasswordDestination"
                             AutomationProperties.Name="{DynamicResource S.Password.NewFile}"
                             Text="{Binding Destination}"/>
                    <TextBlock Text="{DynamicResource S.Password.SourceUntouched}"
                               FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- There is no new database to connect to after a rewrap, and no transfer either.
                     Left visible it would be a checkbox describing the other operation. -->
                <CheckBox Name="PasswordConnectAfterwards"
                          AutomationProperties.AutomationId="PasswordConnectAfterwards"
                          IsVisible="{Binding !IsRewrap}"
                          IsChecked="{Binding ConnectAfterwards}"
                          Content="{DynamicResource S.Password.ConnectAfterwards}"/>

                <!-- The third piece of chrome that describes the migration: a rewrap runs no script
                     and counts nothing on two sides, because there is only one side. -->
                <TextBlock Text="{DynamicResource S.Password.ItIsAScript}"
                           IsVisible="{Binding !IsRewrap}"
                           FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Name="PasswordMigrateButton"
                        AutomationProperties.AutomationId="PasswordMigrate"
                        Command="{Binding MigrateCommand}"
                        Content="{Binding ActionLabel}"/>

                <Button Grid.Column="2"
                        Name="PasswordCloseButton"
                        AutomationProperties.AutomationId="PasswordClose"
                        Command="{Binding CloseCommand}"
                        Content="{DynamicResource S.Common.Close}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
