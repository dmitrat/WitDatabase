<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="OutWit.Database.Studio.Views.Dialogs.CreateTableDialog"
        x:DataType="vm:CreateTableViewModel"
        Title="{DynamicResource S.Dialog.CreateTable.Title}"
        Width="900" Height="700"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,0,0,1"
                Padding="16">
            <TextBlock Text="{DynamicResource S.Dialog.CreateTable.Heading}"
                       FontSize="{DynamicResource Wit.Font.WindowTitle}"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="16">
                
                <!-- Table Name -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource S.Dialog.CreateTable.Name}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding TableName}"
                             Watermark="{DynamicResource S.Dialog.CreateTable.NameHint}"
                             Width="400"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Columns Grid -->
                <StackPanel Spacing="8">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource S.Dialog.CreateTable.Columns}" 
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        
                        <Button AutomationProperties.AutomationId="CreateTableAddColumn" Content="{DynamicResource S.Dialog.CreateTable.AddColumn}"
                                Command="{Binding AddColumnCommand}"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Margin="8,0,0,0"/>
                    </DockPanel>

                    <Border BorderBrush="{DynamicResource Wit.Line}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DataGrid ItemsSource="{Binding Columns}"
                                  SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  MinHeight="200"
                                  MaxHeight="400">
                            
                            <DataGrid.Columns>
                                
                                <!-- Column Name -->
                                <DataGridTextColumn Header="{DynamicResource S.Common.Name}"
                                                    Binding="{Binding Name}"
                                                    Width="150"
                                                    IsReadOnly="False"/>

                                <!-- Data Type -->
                                <DataGridTemplateColumn Header="{DynamicResource S.Column.DataType}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- The TEXT is bound as well as the selection: the box
                                                 takes free text on purpose - the list itself offers
                                                 VARCHAR(255) and CHAR(50), so a length is meant to be
                                                 typed - and binding only the selection threw away
                                                 everything that matched no item. -->
                                            <ComboBox ItemsSource="{Binding $parent[Window].((vm:CreateTableViewModel)DataContext).AvailableDataTypes}"
                                                      SelectedItem="{Binding DataType}"
                                                      Text="{Binding DataType, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      IsEditable="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Nullable -->
                                <DataGridCheckBoxColumn Header="{DynamicResource S.Column.Nullable}"
                                                        Binding="{Binding IsNullable}"
                                                        Width="SizeToHeader"/>

                                <!-- Primary Key -->
                                <DataGridCheckBoxColumn Header="{DynamicResource S.Column.PrimaryKey}"
                                                        Binding="{Binding IsPrimaryKey}"
                                                        Width="SizeToHeader"/>

                                <!-- Auto Increment -->
                                <DataGridCheckBoxColumn Header="{DynamicResource S.Column.AutoIncrement}"
                                                        Binding="{Binding IsAutoIncrement}"
                                                        Width="SizeToHeader"/>

                                <!-- Unique -->
                                <DataGridCheckBoxColumn Header="{DynamicResource S.Column.Unique}"
                                                        Binding="{Binding IsUnique}"
                                                        Width="SizeToHeader"/>

                                <!-- Default Value -->
                                <DataGridTextColumn Header="{DynamicResource S.Column.Default}"
                                                    Binding="{Binding DefaultValue}"
                                                    Width="120"
                                                    IsReadOnly="False"/>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="{DynamicResource S.Common.Actions}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button AutomationProperties.AutomationId="CreateTableRemove" Content="{DynamicResource S.Common.Remove}"
                                                    Command="{Binding $parent[Window].((vm:CreateTableViewModel)DataContext).RemoveColumnCommand}"
                                                    IsEnabled="{Binding $parent[Window].((vm:CreateTableViewModel)DataContext).CanRemoveColumn}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    Padding="8,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- Generated DDL -->
                <StackPanel Spacing="8">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource S.Dialog.CreateTable.Ddl}"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        
                        <Button AutomationProperties.AutomationId="CreateTableGenerateDDL" Content="{DynamicResource S.Dialog.CreateTable.GenerateDdl}"
                                Command="{Binding GenerateDdlCommand}"
                                IsEnabled="{Binding CanGenerateDdl}"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Margin="8,0,0,0"/>
                    </DockPanel>

                    <!-- A type this engine does not know is refused HERE, where it can still be
                         corrected: the engine refuses an unknown type name rather than mapping it
                         to TEXT, so the statement would fail on Create with the dialog already
                         closed. -->
                    <Border AutomationProperties.AutomationId="CreateTableTypeProblem"
                            Background="{DynamicResource Wit.Warn.Surface}"
                            BorderBrush="{DynamicResource Wit.Warn.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            IsVisible="{Binding TypeProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding TypeProblem}"
                                   Foreground="{DynamicResource Wit.Warn.Text}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border BorderBrush="{DynamicResource Wit.Line}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            MinHeight="150"
                            MaxHeight="200"
                            IsVisible="{Binding GeneratedDdl, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding GeneratedDdl}"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas,Courier New"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Error Message -->
        <Border Grid.Row="2"
                Background="{DynamicResource Wit.Warn.Surface}"
                BorderBrush="{DynamicResource Wit.Warn.Border}"
                BorderThickness="1"
                Padding="12"
                Margin="16,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource S.Common.ErrorHeading}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Wit.Warn.Text}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Wit.Warn.Text}"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="3"
                Background="{DynamicResource Wit.Surface.Panel}"
                BorderBrush="{DynamicResource Wit.Line}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                
                <Button AutomationProperties.AutomationId="CreateTableCancel" Content="{DynamicResource S.Common.Cancel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"
                        HorizontalContentAlignment="Center"/>
                
                <Button AutomationProperties.AutomationId="CreateTableCreateTable" Content="{DynamicResource S.Dialog.CreateTable.Create}"
                        Command="{Binding CreateTableCommand}"
                        IsEnabled="{Binding CanCreateTable}"
                        MinWidth="120"
                        HorizontalContentAlignment="Center"
                        Classes="accent"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource Wit.Scrim}"
                IsVisible="{Binding IsCreating}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Width="48" Height="48"
                        Background="White"
                        CornerRadius="24">
                    <TextBlock Text="..."
                               FontSize="{DynamicResource Wit.Font.WindowTitle}"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource S.Dialog.CreateTable.Creating}"
                           Foreground="White"
                           FontSize="{DynamicResource Wit.Font.SectionTitle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
