<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="560"
        x:Class="OutWit.Database.Studio.Views.Dialogs.KeyboardHelpDialog"
        x:DataType="vm:KeyboardHelpViewModel"
        Title="{DynamicResource S.Keys.Title}"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner">

    <!-- A reference with a search over it (9.6). Reassigning is deliberately absent and the window
         says why: the gestures are declared in the shell, not read from this list, so a box here
         would accept a key and change nothing. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14">

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource S.Keys.Title}"
                   FontSize="{DynamicResource Wit.Font.SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1"
                 Name="KeyboardFilter"
                 AutomationProperties.AutomationId="KeyboardFilter"
                 AutomationProperties.Name="{DynamicResource S.Keys.Search}"
                 Watermark="{DynamicResource S.Keys.Search}"
                 Margin="0,0,0,10"
                 Text="{Binding Filter, Mode=TwoWay}"/>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="3"
                BorderBrush="{DynamicResource Wit.Line}">
            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,140,110" Margin="10,7">
                    <TextBlock Grid.Column="0" Text="{DynamicResource S.Keys.Head.Action}"
                               FontSize="{DynamicResource Wit.Font.Caption}" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource S.Keys.Head.Gesture}"
                               FontSize="{DynamicResource Wit.Font.Caption}" Opacity="0.6"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource S.Keys.Head.Scope}"
                               FontSize="{DynamicResource Wit.Font.Caption}" Opacity="0.6"/>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl Name="KeyboardShortcuts"
                                  AutomationProperties.AutomationId="KeyboardShortcuts"
                                  ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyboardRow">
                                <Grid ColumnDefinitions="*,140,110" Margin="10,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Action}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" HorizontalAlignment="Left"
                                            Background="{DynamicResource Wit.Surface.Panel}"
                                            CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding Gesture}" FontFamily="Consolas" FontSize="{DynamicResource Wit.Font.Mono.Data}"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Scope}"
                                               FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.7" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Name="KeyboardNothing"
                   AutomationProperties.AutomationId="KeyboardNothing"
                   Text="{DynamicResource S.Keys.Nothing}"
                   IsVisible="{Binding IsEmpty}"
                   Margin="0,8,0,0" Opacity="0.7"/>

        <StackPanel Grid.Row="4" Spacing="8" Margin="0,12,0,0">

            <!-- Why the design's rebinding field is not here. A window that offered one and changed
                 nothing would be worse than this sentence. -->
            <TextBlock Text="{Binding RebindingNote}"
                       TextWrapping="Wrap" FontSize="{DynamicResource Wit.Font.Control}" Opacity="0.65"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="KeyboardCopy"
                        AutomationProperties.AutomationId="KeyboardCopy"
                        AutomationProperties.Name="{DynamicResource S.Keys.Copy}"
                        Content="{DynamicResource S.Keys.Copy}"
                        Command="{Binding CopyCommand}"/>

                <Button Name="KeyboardClose"
                        AutomationProperties.AutomationId="KeyboardClose"
                        AutomationProperties.Name="{DynamicResource S.Common.Close}"
                        Content="{DynamicResource S.Common.Close}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
