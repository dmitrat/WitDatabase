<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="640"
        x:Class="OutWit.Database.Studio.Views.Dialogs.CreateIndexDialog"
        x:DataType="vm:CreateIndexViewModel"
        Title="{DynamicResource S.Dialog.CreateIndex.Title}"
        Width="640" Height="640"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <!-- 5.4: everything the engine takes, in one short dialog - and next to the two options it stores
         without using, a line saying so. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{x:Static ui:StudioIcons.DB_INDEX}" Width="20" Height="20"/>
                <TextBlock Text="{DynamicResource S.Dialog.CreateIndex.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TableName}" FontSize="14" Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="14">

                <!-- The key note, in three states (WS-44) -->
                <Border CornerRadius="4" Padding="10"
                        Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                        IsVisible="{Binding KeyNoteIsSevere}">
                    <TextBlock Text="{Binding KeyNote}" TextWrapping="Wrap" Foreground="#856404"/>
                </Border>

                <TextBlock Text="{Binding KeyNote}" TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                           IsVisible="{Binding !KeyNoteIsSevere}"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource S.Common.Name}" FontWeight="SemiBold"/>
                    <TextBox AutomationProperties.AutomationId="CreateIndexName"
                             Text="{Binding IndexName}" PlaceholderText="IX_Orders_CreatedAt"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource S.Common.Table}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ComboBox Grid.Column="0"
                                  AutomationProperties.AutomationId="CreateIndexTable"
                                  ItemsSource="{Binding AvailableTables}"
                                  SelectedItem="{Binding TableName}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="{DynamicResource S.Dialog.CreateIndex.SelectTable}"/>

                        <Button Grid.Column="1" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="CreateIndexLoadTables"
                                AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.LoadTables}"
                                Content="{DynamicResource S.Dialog.CreateIndex.Tables}" Command="{Binding LoadTablesCommand}"/>

                        <Button Grid.Column="2" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="CreateIndexLoadColumns"
                                AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.LoadColumns}"
                                Content="{DynamicResource S.Common.Columns}" Command="{Binding LoadColumnsCommand}"
                                IsEnabled="{Binding CanLoadColumns}"/>
                    </Grid>
                </StackPanel>

                <!-- Key columns, each with a direction -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource S.Common.Columns}" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*,Auto" Height="120">
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ListBox Name="AvailableColumnsList"
                                     AutomationProperties.AutomationId="CreateIndexAvailableColumns"
                                     ItemsSource="{Binding AvailableColumns}"
                                     SelectionMode="Multiple"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button AutomationProperties.AutomationId="CreateIndexAddSelectedColumn"
                                    AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.AddColumn}"
                                    Content="{DynamicResource S.Common.Add}" Width="90" Click="AddColumn_Click"/>
                            <Button AutomationProperties.AutomationId="CreateIndexAddIncluded"
                                    AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.AddIncluded}"
                                    Content="INCLUDE" Width="90" Click="AddIncluded_Click"
                                    ToolTip.Tip="{DynamicResource S.Dialog.CreateIndex.Include.Tip}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SelectedColumns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IndexColumnViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Expression}" VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" FontSize="11" Margin="0,0,4,0"
                                            AutomationProperties.AutomationId="CreateIndexToggleDirection"
                                            AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.Direction}"
                                            Content="{Binding IsDescending, Converter={x:Static vm:DirectionConverter.Instance}}"
                                            Command="{Binding $parent[ItemsControl].((vm:CreateIndexViewModel)DataContext).ToggleDirectionCommand}"
                                            CommandParameter="{Binding}"/>

                                    <Button Grid.Column="2" Content="✕" FontSize="11" Width="24"
                                            AutomationProperties.AutomationId="CreateIndexRemoveColumn"
                                            AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.RemoveColumn}"
                                            Command="{Binding $parent[ItemsControl].((vm:CreateIndexViewModel)DataContext).RemoveColumnCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox AutomationProperties.AutomationId="CreateIndexExpression"
                             Name="ExpressionBox"
                             PlaceholderText="{DynamicResource S.Dialog.CreateIndex.Expression}"
                             KeyDown="Expression_KeyDown"
                             FontFamily="Consolas,Courier New"/>
                </StackPanel>

                <!-- Included columns -->
                <StackPanel Spacing="4" IsVisible="{Binding IncludedColumns.Count}">
                    <TextBlock Text="INCLUDE" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding IncludedColumns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" FontSize="11" Width="24"
                                            AutomationProperties.AutomationId="CreateIndexRemoveIncluded"
                                            AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.RemoveIncluded}"
                                            Command="{Binding $parent[ItemsControl].((vm:CreateIndexViewModel)DataContext).RemoveIncludedCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <CheckBox AutomationProperties.AutomationId="CreateIndexUnique"
                          Content="UNIQUE" IsChecked="{Binding IsUnique}"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource S.Dialog.CreateIndex.Partial}" FontWeight="SemiBold"/>
                    <TextBox AutomationProperties.AutomationId="CreateIndexFilter"
                             Text="{Binding FilterCondition}"
                             PlaceholderText="Status &lt;&gt; 'archived'"
                             FontFamily="Consolas,Courier New"/>
                </StackPanel>

                <!-- What the planner will and will not do with these choices -->
                <TextBlock Text="{Binding PlannerNote}" TextWrapping="Wrap" FontSize="11" Foreground="#856404"
                           IsVisible="{Binding PlannerNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource S.Common.WhatWillRun}" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="4" Padding="8" MinHeight="48">
                        <TextBlock Text="{Binding GeneratedDdl}"
                                   FontFamily="Consolas,Courier New" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FDECEA" BorderBrush="#E57373" BorderThickness="1"
                Padding="12" Margin="16,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#8B2E2E"/>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="CreateIndexToEditor"
                        Content="{DynamicResource S.Common.ToEditor}" Command="{Binding SendToEditorCommand}"
                        IsEnabled="{Binding CanGenerateDdl}"/>

                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="CreateIndexCancel"
                        AutomationProperties.Name="{DynamicResource S.Common.Cancel}"
                        Content="{DynamicResource S.Common.Cancel}" Command="{Binding CancelCommand}"
                        Width="100" Margin="0,0,8,0" HorizontalContentAlignment="Center"/>

                <Button Grid.Column="3"
                        AutomationProperties.AutomationId="CreateIndexCreate"
                        AutomationProperties.Name="{DynamicResource S.Dialog.CreateIndex.CreateName}"
                        Content="{DynamicResource S.Common.Create}" Command="{Binding CreateIndexCommand}"
                        IsEnabled="{Binding CanCreateIndex}"
                        Width="120" HorizontalContentAlignment="Center" Classes="accent"/>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" IsVisible="{Binding IsCreating}">
            <TextBlock Text="{DynamicResource S.Dialog.CreateIndex.Creating}" Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>

</Window>
