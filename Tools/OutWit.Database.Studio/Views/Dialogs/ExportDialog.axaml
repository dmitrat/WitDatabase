<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutWit.Database.Studio.ViewModels"
        xmlns:ui="using:OutWit.Database.Studio.Ui.Icons"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="480"
        x:Class="OutWit.Database.Studio.Views.Dialogs.ExportDialog"
        x:DataType="vm:ExportViewModel"
        Title="{Binding WindowTitle}"
        Width="560"
        Height="620"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="*,Auto" Margin="20">
        
        <!-- Main Content. It SCROLLS: the window used to open 500x480 for content that needs
             about 900, and a StackPanel that does not fit its row does not clip - it draws
             over whatever is beneath, which here is the row of buttons. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- WS-51: the SCOPE comes first, because it is the only thing that distinguishes twelve
                 selected rows from a whole table, and asking for it last is what makes someone export
                 the wrong thing and then do it again. Each option carries its own count. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsQueryResult}">
                <TextBlock Text="{DynamicResource S.Dialog.Export.What}" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton AutomationProperties.AutomationId="ExportScopeSelection"
                                 GroupName="Scope"
                                 IsEnabled="{Binding CanExportSelection}"
                                 IsChecked="{Binding SelectedScope, Converter={x:Static vm:ExportScopes.IsSelection}}"
                                 Command="{Binding ChooseScopeCommand}" CommandParameter="Selection"
                                 Content="{Binding SelectionLabel}"/>
                    <RadioButton AutomationProperties.AutomationId="ExportScopePage"
                                 GroupName="Scope"
                                 IsChecked="{Binding SelectedScope, Converter={x:Static vm:ExportScopes.IsPage}}"
                                 Command="{Binding ChooseScopeCommand}" CommandParameter="Page"
                                 Content="{Binding PageLabel}"/>
                    <RadioButton AutomationProperties.AutomationId="ExportScopeEverything"
                                 GroupName="Scope"
                                 IsChecked="{Binding SelectedScope, Converter={x:Static vm:ExportScopes.IsEverything}}"
                                 Command="{Binding ChooseScopeCommand}" CommandParameter="Everything"
                                 Content="{Binding EverythingLabel}"/>
                </StackPanel>
            </StackPanel>

            <!-- Source Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource S.Dialog.Export.Source}" FontWeight="SemiBold"/>
                
                <!-- Query Result indicator -->
                <Border Background="{DynamicResource Wit.Accent.Dim}"
                        BorderBrush="{DynamicResource Wit.Accent}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8"
                        IsVisible="{Binding IsQueryResult}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static ui:StudioIcons.QUERY_EXECUTE}"
                                  Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"
                                  Foreground="{DynamicResource Wit.Accent.Text}"/>
                        <!-- One string, not five Runs. A sentence assembled out of fragments cannot
                             be translated: the word order of another language moves the pieces. -->
                        <TextBlock AutomationProperties.AutomationId="ExportQuerySource"
                                   Text="{Binding QuerySourceSummary}"
                                   Foreground="{DynamicResource Wit.Accent.Text}"/>
                    </StackPanel>
                </Border>
                
                <!-- Table selection -->
                <ComboBox ItemsSource="{Binding AvailableTables}"
                          SelectedItem="{Binding SelectedTable}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding !IsQueryResult}"
                          IsEnabled="{Binding !IsExporting}"
                          PlaceholderText="{DynamicResource S.Dialog.Export.SelectTable}"/>
            </StackPanel>

            <!-- Format Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource S.Dialog.Export.Format}" FontWeight="SemiBold"/>
                <StackPanel Spacing="4">
                    <RadioButton AutomationProperties.AutomationId="ExportFormatCsv"
                                 AutomationProperties.Name="{DynamicResource S.Dialog.Export.CsvName}"
                                 GroupName="Format"
                                 IsEnabled="{Binding !IsExporting}"
                                 IsChecked="{Binding SelectedFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ExportFormat.Csv}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="CSV" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Export.CsvHint}" 
                                       Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.AutomationId="ExportFormatJson"
                                 AutomationProperties.Name="{DynamicResource S.Dialog.Export.JsonName}"
                                 GroupName="Format"
                                 IsEnabled="{Binding !IsExporting}"
                                 IsChecked="{Binding SelectedFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ExportFormat.Json}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="JSON" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Export.JsonHint}" 
                                       Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.AutomationId="ExportFormatSql"
                                 AutomationProperties.Name="{DynamicResource S.Dialog.Export.SqlName}"
                                 GroupName="Format"
                                 IsEnabled="{Binding !IsExporting}"
                                 IsChecked="{Binding SelectedFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ExportFormat.Sql}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="SQL" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S.Dialog.Export.SqlHint}" 
                                       Foreground="{DynamicResource Wit.Ink.Secondary}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <!-- Options -->
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource S.Dialog.Export.Options}" FontWeight="SemiBold"/>
                <CheckBox Content="{DynamicResource S.Dialog.Export.IncludeHeaders}"
                          IsChecked="{Binding IncludeHeaders}"
                          IsEnabled="{Binding !IsExporting}"
                          IsVisible="{Binding SelectedFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ExportFormat.Csv}}"/>
                <CheckBox Content="{DynamicResource S.Dialog.Export.IsoDates}"
                          IsChecked="{Binding FormatDatesAsIso}"
                          IsEnabled="{Binding !IsExporting}"/>
            </StackPanel>

            <!-- Output File -->
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource S.Dialog.Export.Output}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputPath}"
                             Watermark="{DynamicResource S.Dialog.Export.SelectOutput}"
                             ToolTip.Tip="{DynamicResource S.Dialog.Export.Output}"/>
                    <Button AutomationProperties.AutomationId="ExportBrowse" Grid.Column="1"
                            Content="{DynamicResource S.Common.Browse}"
                            Command="{Binding BrowseCommand}"
                            IsEnabled="{Binding !IsExporting}"
                            Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Error Message -->
            <Border Background="{DynamicResource Wit.Error.Surface}"
                    BorderBrush="{DynamicResource Wit.Error.Border}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <!-- A Grid: a horizontal StackPanel measures with infinite width, so the Wrap below could never happen and a long message drew over what was beside it. -->
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="{x:Static ui:StudioIcons.COMMON_WARNING}"
                              Width="{DynamicResource Wit.Icon.Header}" Height="{DynamicResource Wit.Icon.Header}"
                              Foreground="{DynamicResource Wit.Error.Text}"/>
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Wit.Error.Text}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
            
        </StackPanel>
        </ScrollViewer>


        <!-- Buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,20,0,0">
            <Button AutomationProperties.AutomationId="ExportCancel" Grid.Column="1"
                    Content="{DynamicResource S.Common.Cancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    IsVisible="{Binding !IsExporting}"/>
            <Button AutomationProperties.AutomationId="ExportExport" Grid.Column="2"
                    Content="{DynamicResource S.Dialog.Export.Export}"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding CanExport}"
                    MinWidth="80"
                    Classes="accent"
                    IsVisible="{Binding !IsExporting}"/>
        </Grid>
        
        <!-- Loading Overlay with Progress -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource Wit.Scrim}"
                IsVisible="{Binding IsExporting}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Width="300">
                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ExportProgress}"
                             Minimum="0"
                             Maximum="100"
                             Height="8"/>
                
                <!-- Progress Text -->
                <!-- The numbers wait for the total: the panel opens before the rows are fetched,
                     so its first frame said "0 / 0 rows" at "0.0 %". -->
                <TextBlock AutomationProperties.AutomationId="ExportProgressText"
                           Text="{Binding ProgressText}"
                           IsVisible="{Binding KnowsHowManyRows}"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource Wit.Font.SectionTitle}"/>

                <!-- Percentage -->
                <TextBlock IsVisible="{Binding KnowsHowManyRows}"
                           Text="{Binding ExportProgress, StringFormat='{}{0:F1} %'}"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource Wit.Font.SectionTitle}"
                           Opacity="0.8"/>
                
                <!-- Cancel Button -->
                <Button AutomationProperties.AutomationId="ExportCancelExport" Content="{DynamicResource S.Dialog.Export.CancelExport}"
                        Command="{Binding CancelExportCommand}"
                        HorizontalAlignment="Center"
                        MinWidth="120"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        
    </Grid>

</Window>