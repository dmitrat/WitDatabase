<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>WitDatabaseStudio</AssemblyName>
    <ApplicationIcon>Assets\Branding\WitDatabaseStudio.ico</ApplicationIcon>

    <!-- Studio is a desktop application, not a library. Directory.Build.props turns
         GeneratePackageOnBuild on for everything that is not a test project and does not
         opt out, which was producing an OutWit.Database.Studio.<version>.nupkg on every
         Release build. -->
    <IsPackable>false</IsPackable>

    <!-- Release info. The release workflow overrides Version from the studio-v* tag; this
         is what a local build gets. -->
    <Version>3.0.0-dev</Version>
    <Product>WitDatabase Studio</Product>
    <Company>OutWit</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- The branding sources are packaging inputs, not things to embed in the assembly. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Branding\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Syntax\WitSql.xshd" />
    <EmbeddedResource Include="Syntax\WitSqlLight.xshd" />

    <!-- Both string catalogues are embedded rather than shipped as satellite assemblies: Studio is
         packed for three platforms, and a satellite that fails to arrive turns the interface English
         with no error anywhere.

         LogicalName and WithCulture are NOT decoration. MSBuild reads the ".en" and ".ru" in a file
         name as a CULTURE and strips it, so both files came out as the single manifest resource
         "…Resources.Strings.json" - one silently overwriting the other, and neither reachable under
         the name it was asked for. Measured: GetManifestResourceNames listed the two xshd files and
         nothing else. Naming them by culture is exactly what invites the satellite machinery this
         choice exists to avoid. -->
    <EmbeddedResource Include="Resources\Strings.en.json"
                      LogicalName="OutWit.Database.Studio.Resources.Strings.en.json"
                      WithCulture="false" />
    <EmbeddedResource Include="Resources\Strings.ru.json"
                      LogicalName="OutWit.Database.Studio.Resources.Strings.ru.json"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
	  <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageReference Include="OutWit.Common.MVVM.Avalonia" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sources\Providers\OutWit.Database.AdoNet\OutWit.Database.AdoNet.csproj" />

    <!-- Cutting a script into statements, and putting an error back on the line the user wrote it
         on, need the engine's own understanding of the language. The alternative - reimplementing
         it in the client - guarantees that the two drift apart, and a client that disagrees with
         the engine about where a statement ends is worse than one that cannot split at all.
         The packages version together and the parser pulls no storage behind it. -->
    <ProjectReference Include="..\..\Sources\Engine\OutWit.Database.Parser\OutWit.Database.Parser.csproj" />

    <!-- ChaCha20-Poly1305 lives in its own package, and without it Studio can offer AES-GCM and
         nothing else - the Create dialog's second algorithm would be a control that produces a
         database Studio cannot reopen. Measured: with the reference and an explicit EnsureRegistered
         in Program, a ChaCha20 database created and reopened through Studio's own connection string
         round-trips. -->
    <ProjectReference Include="..\..\Sources\Core\OutWit.Database.Core.BouncyCastle\OutWit.Database.Core.BouncyCastle.csproj" />
  </ItemGroup>
</Project>
