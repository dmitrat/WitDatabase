<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <Version>10.0.0</Version>
    <Description>SQL execution engine for WitDatabase. Full SQL support including JOINs, subqueries, CTEs, window functions, triggers, and 60+ built-in functions.</Description>
    <PackageTags>OutWit;database;sql;engine;query;execution;cte;window-functions;triggers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!--
      IteratorExcludeInternal is internal - it is a plan detail, not API. The planner's own tests
      assert plan shape, and SELECT * now always ends in that wrapper, so they have to be able to
      see through it to the iterator underneath.
    -->
    <InternalsVisibleTo Include="OutWit.Database.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OutWit.Common" Version="1.3.2" />
    <PackageReference Include="OutWit.Common.MemoryPack" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OutWit.Database.Core\OutWit.Database.Core.csproj" />
    <ProjectReference Include="..\OutWit.Database.Parser\OutWit.Database.Parser.csproj" />
  </ItemGroup>

</Project>

