<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.11.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.0.1" />
    <PackageReference Include="OutWit.Common.NUnit" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Database.Parser\OutWit.Database.Parser.csproj" />
    <ProjectReference Include="..\OutWit.Database\OutWit.Database.csproj" />

    <!--
      The crash runner is launched as a separate process, not called into - but the reference is a
      real one so that the tests share its line protocol and scenario names instead of duplicating
      them. A drifted protocol would not fail loudly: the test would wait for a line that is never
      printed and time out, which reads like a defect in the engine rather than in the harness.
    -->
    <ProjectReference Include="..\..\..\Tools\OutWit.Database.CrashRunner\OutWit.Database.CrashRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Where to find the runner's own build output - which, unlike the copy that lands next to the
      tests, carries the runtimeconfig.json that `dotnet exec` needs. Baked in at build time so it
      always names the matching configuration and target framework.
    -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CrashRunnerDirectory</_Parameter1>
      <!-- Forward slashes on purpose: MSBuild accepts them on Windows, and Path.GetFullPath does not
           treat a backslash as a separator on Linux, where CI runs. -->
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../Tools/OutWit.Database.CrashRunner/bin/$(Configuration)/$(TargetFramework)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!--
      The pinned DDL round-trip corpus. Data rather than logic: it records, per declaration, whether
      the declaration is recorded in the catalog, reported by INFORMATION_SCHEMA and enforced. The
      corpus test fails in both directions, so a declaration that starts being honoured is reported
      just as loudly as one that stops.
    -->
    <None Include="Schema\ddl-round-trip-corpus.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
