<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <Version>3.0.1</Version>
    <Description>Entity Framework Core provider for WitDatabase. Full EF Core support including migrations, scaffolding, LINQ translation, and design-time services.</Description>
    <PackageTags>OutWit;database;entity-framework;ef-core;orm;linq;migrations;scaffolding</PackageTags>
  </PropertyGroup>

  <!--
      Microsoft.EntityFrameworkCore.Design is needed to COMPILE this assembly (WitDesignTimeServices
      implements IDesignTimeServices) but must not flow to consumers. With PrivateAssets=none it was a
      public dependency, so every app referencing this provider restored Roslyn, MSBuild and a net472
      build host into bin/ - and, on net10.0, the vulnerable System.Security.Cryptography.Xml 9.0.0
      via Microsoft.Build.Tasks.Core (seven high-severity advisories). PrivateAssets=all with
      IncludeAssets=compile gives us the reference assemblies and nothing else; at design time
      `dotnet ef` supplies Design itself, as it does for every other provider.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6"
                      PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1"
                      PrivateAssets="all" IncludeAssets="compile" />

    <!--
        Design (net10.0) pulls Microsoft.Build.Tasks.Core, which pins
        System.Security.Cryptography.Xml 9.0.0 - seven high-severity advisories. PrivateAssets above
        already keeps it out of the shipped package graph; this pins it forward so our own restore is
        clean too and the warning does not train everyone to ignore NU1903. Private, because nothing
        here uses XML signing. Remove once Design stops depending on a vulnerable MSBuild.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Database.AdoNet\OutWit.Database.AdoNet.csproj" />
  </ItemGroup>

</Project>
