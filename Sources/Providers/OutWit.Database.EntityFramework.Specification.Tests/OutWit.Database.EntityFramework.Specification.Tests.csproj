<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      EF Core's specification suite is xunit-based and cannot be run under NUnit, so this project is
      separate from OutWit.Database.EntityFramework.Tests rather than folded into it.
    -->
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OutWit.Database.EntityFramework.Specification.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!--
      The specification packages depend on xunit.runner.visualstudio, but a transitive package's
      build assets are not imported, so without this reference the assembly builds and then reports
      "no test is available".
    -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <!--
    The phase-9 dialect oracle. Every other conformance instrument here compares against SQLite,
    which lacks most of the capabilities phase 9 has to decide about - so SQLite cannot answer
    "does the drop-in target have this". PostgreSQL and SQL Server can.

    Test-only, and this project is not packable, so nothing ships them. The oracle skips when no
    server is reachable, so a machine without Docker runs the rest of the suite unaffected.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Database.EntityFramework\OutWit.Database.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
