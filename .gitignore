# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.dotsettings

# Mono Auto Generated Files
mono_crash.*

#Nuget
*.nupkg
*.snupkg

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2019/2022
.vscode/
.vs/
.vscode/settings.json

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# C# Project files
project.lock.json
project.fragment.lock.json
artifacts/

# Auto-generated files by Visual Studio
*.dbmdl
*.pdb
*.cache
*.ilk
*.log
*.userprefs
*.tlog
*.vspscc
*.vspx

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Entity Framework Migrations
Migrations/
# Exception: EF provider implementation files (not auto-generated migrations)
!Sources/Providers/OutWit.Database.EntityFramework/Migrations/

# Rider specific folders
.idea/
.idea_modules/

# JetBrains Rider
.idea/
.idea_modules/

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# VS Code workspace file - local, not shared
*.code-workspace

# Working papers: the audit and the phase plans. They are kept LOCALLY - they are
# where the planning and the record of each phase live - but they are not part of
# what a visitor to Docs/ should see. Only the language specification and the known
# issues are published, so the folder is ignored with those two allowed back in.
Docs/*
!Docs/WitSQL.md
!Docs/KnownIssues.md
